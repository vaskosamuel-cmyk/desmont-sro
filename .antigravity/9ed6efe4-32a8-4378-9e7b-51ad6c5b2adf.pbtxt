    command_line: "cat << \'EOF\' > rewrite_services.cjs\nconst fs = require(\'fs\');\n\nconst services = [\n  {\n    oldFile: \'src/pages/Sluzby.tsx\',\n    newFile: \'src/pages/StavbyNaKluc.tsx\',\n    componentName: \'StavbyNaKluc\',\n    title: \'STAVBY NA K\304\275\303\232\304\214\',\n    titleHtml: \'STAVBY <br /> NA <br /> <span className=\"text-[#E5A93B]\">K\304\275\303\232\304\214</span>\',\n    subtitle: \'Kompletn\303\241 v\303\275stavba rodinn\303\275ch domov od z\303\241kladovej dosky a\305\276 po odovzdanie.\',\n    image: \'https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=800\',\n    eyebrow: \'BEZSTAROSTN\303\201 V\303\235STAVBA\',\n    h2: \'V\303\241\305\241 nov\303\275 domov <br/> <span className=\"text-[#E5A93B]\">bez starost\303\255</span>\',\n    p1: \'Stavba rodinn\303\251ho domu je ve\304\276k\303\275 krok.\',\n    p2: \'Postar\303\241me sa o kompletn\303\272 realiz\303\241ciu od v\303\275kopov a\305\276 po fin\303\241lne odovzdanie k\304\276\303\272\304\215ov. S nami m\303\241te istotu dodr\305\276ania term\303\255nov a rozpo\304\215tu.\',\n    featureEyebrow: \'PRE\304\214O STAVA\305\244 S NAMI?\',\n    f1Title: \'KOMPLETN\303\235 SERVIS\',\n    f1Desc: \'Zastre\305\241\303\255me v\305\241etky procesy a remesl\303\241 na jednom mieste.\',\n    f2Title: \'KVALITN\303\211 MATERI\303\201LY\',\n    f2Desc: \'Pracujeme len s overen\303\275mi stavebn\303\275mi materi\303\241lmi a postupmi.\',\n    f3Title: \'Z\303\201RUKA NA DIELO\',\n    f3Desc: \'Za na\305\241ou pr\303\241cou si stoj\303\255me a poskytujeme pln\303\272 z\303\241ruku na zrealizovan\303\272 stavbu.\',\n    processEyebrow: \'AKO PREBIEHA V\303\235STAVBA\',\n    processH2: \'Od z\303\241kladov <br /> <span className=\"text-[#E5A93B]\">a\305\276 po strechu</span>\',\n    pStep1Name: \'01 Pr\303\255prava\',\n    pStep1Desc: \'Zemn\303\251 pr\303\241ce a vybudovanie pevn\303\275ch z\303\241kladov.\',\n    pStep2Name: \'02 Hrub\303\241 stavba\',\n    pStep2Desc: \'Murovanie, \305\276elezobet\303\263nov\303\251 kon\305\241trukcie a strecha.\',\n    pStep3Name: \'03 In\305\241tal\303\241cie\',\n    pStep3Desc: \'Rozvody vody, elektriny, k\303\272renia a odpadov.\',\n    pStep4Name: \'04 Dokon\304\215enie\',\n    pStep4Desc: \'Omietky, fas\303\241da a fin\303\241lne interi\303\251rov\303\251 \303\272pravy.\',\n    galleryTitle: \'NA\305\240E STAVBY\'\n  },\n  {\n    oldFile: \'src/pages/Starostlivost.tsx\',\n    newFile: \'src/pages/Rekonstrukcie.tsx\',\n    componentName: \'Rekonstrukcie\',\n    title: \'REKON\305\240TRUKCIE\',\n    titleHtml: \'KOMPLETN\303\211 <br /> <span className=\"text-[#E5A93B]\">REKON\305\240TRUKCIE</span>\',\n    subtitle: \'Kompletn\303\251 rekon\305\241trukcie domov a bytov vr\303\241tane prer\303\241bky bytov\303\275ch jadier a k\303\272pe\304\276n\303\255 na k\304\276\303\272\304\215.\',\n    image: \'https://images.unsplash.com/photo-1588854337221-4cfb9264c919?auto=format&fit=crop&q=80&w=800\',\n    eyebrow: \'NOV\303\235 \305\275IVOT PRE V\303\201\305\240 DOMOV\',\n    h2: \'Dajte svojmu domovu <br/> <span className=\"text-[#E5A93B]\">nov\303\275 dych</span>\',\n    p1: \'Rekon\305\241trukcia vy\305\276aduje sk\303\272senosti a cit.\',\n    p2: \'\304\214i u\305\276 ide o rekon\305\241trukciu bytov\303\251ho jadra, k\303\272pe\304\276ne, alebo kompletn\303\272 prestavbu cel\303\251ho domu, sme tu pre v\303\241s.\',\n    featureEyebrow: \'PRE\304\214O REKON\305\240TRUOVA\305\244 S NAMI?\',\n    f1Title: \'SK\303\232SEN\303\235 T\303\215M\',\n    f1Desc: \'Na\305\241i odborn\303\255ci si poradia aj so zlo\305\276it\303\275mi technick\303\275mi rie\305\241eniami.\',\n    f2Title: \'\304\214ISTOTA A PORIADOK\',\n    f2Desc: \'Db\303\241me na to, aby rekon\305\241trukcia \304\215o najmenej obmedzovala okolie.\',\n    f3Title: \'MODERN\303\211 RIE\305\240ENIA\',\n    f3Desc: \'Prin\303\241\305\241ame modern\303\251 materi\303\241ly a overen\303\251 pracovn\303\251 postupy.\',\n    processEyebrow: \'AKO PREBIEHA REKON\305\240TRUKCIA\',\n    processH2: \'Od b\303\272rania <br /> <span className=\"text-[#E5A93B]\">k nov\303\251mu domovu</span>\',\n    pStep1Name: \'01 B\303\272racie pr\303\241ce\',\n    pStep1Desc: \'Bezpe\304\215n\303\251 odstr\303\241nenie star\303\275ch kon\305\241trukci\303\255 a odvoz sutiny.\',\n    pStep2Name: \'02 Nov\303\251 rozvody\',\n    pStep2Desc: \'V\303\275mena in\305\241tal\303\241ci\303\255 pod\304\276a nov\303\275ch \305\241tandardov.\',\n    pStep3Name: \'03 Mur\303\241rske pr\303\241ce\',\n    pStep3Desc: \'Nov\303\251 omietky, sadrokart\303\263ny a stavebn\303\251 \303\272pravy.\',\n    pStep4Name: \'04 Obklady a dla\305\276by\',\n    pStep4Desc: \'Prec\303\255zna pokl\303\241dka s d\303\264razom na ka\305\276d\303\275 detail.\',\n    galleryTitle: \'UK\303\201\305\275KY PR\303\201C\'\n  },\n  {\n    oldFile: \'src/pages/Strihanie.tsx\',\n    newFile: \'src/pages/ExterierFasady.tsx\',\n    componentName: \'ExterierFasady\',\n    title: \'EXTERI\303\211R A FAS\303\201DY\',\n    titleHtml: \'EXTERI\303\211R <br /> <span className=\"text-[#E5A93B]\">A FAS\303\201DY</span>\',\n    subtitle: \'Zatep\304\276ovanie budov, fas\303\241dne \303\272pravy, zemn\303\251 a v\303\275kopov\303\251 pr\303\241ce, pokl\303\241dka dla\305\276by.\',\n    image: \'https://images.unsplash.com/photo-1628624747186-a941c476b7ef?auto=format&fit=crop&q=80&w=800\',\n    eyebrow: \'DOKONAL\303\201 VIZITKA DOMU\',\n    h2: \'Kvalitn\303\241 fas\303\241da, <br/> <span className=\"text-[#E5A93B]\">ktor\303\241 chr\303\241ni</span>\',\n    p1: \'Fas\303\241da nie je len o vzh\304\276ade, ale najm\303\244 o funk\304\215nosti.\',\n    p2: \'Poskytujeme profesion\303\241lne zateplenie a fas\303\241dne \303\272pravy, ktor\303\251 zn\303\255\305\276ia va\305\241e energetick\303\251 n\303\241klady a ochr\303\241nia dom pred vplyvmi po\304\215asia.\',\n    featureEyebrow: \'PRE\304\214O SI VYBRA\305\244 N\303\201S?\',\n    f1Title: \'ENERGETICK\303\201 \303\232SPORA\',\n    f1Desc: \'Kvalitn\303\251 zateplenie v\303\275razne zni\305\276uje n\303\241klady na vykurovanie.\',\n    f2Title: \'OCHRANA STAVBY\',\n    f2Desc: \'Spr\303\241vna fas\303\241da chr\303\241ni murivo pred vlhkos\305\245ou a degrad\303\241ciou.\',\n    f3Title: \'KOMPLEXN\303\235 EXTERI\303\211R\',\n    f3Desc: \'Od fas\303\241dy a\305\276 po z\303\241mkov\303\272 dla\305\276bu a oplotenie.\',\n    processEyebrow: \'AKO PREBIEHA ZATEPLENIE\',\n    processH2: \'Od izol\303\241cie <br /> <span className=\"text-[#E5A93B]\">k omietke</span>\',\n    pStep1Name: \'01 Pr\303\255prava podkladu\',\n    pStep1Desc: \'O\304\215istenie a penetr\303\241cia pre dokonal\303\272 pri\304\276navos\305\245.\',\n    pStep2Name: \'02 Lepenie izolantu\',\n    pStep2Desc: \'Presn\303\251 nanesenie polystyr\303\251nu alebo miner\303\241lnej vaty.\',\n    pStep3Name: \'03 Armovacia vrstva\',\n    pStep3Desc: \'Zaliatie sklotextilnej mrie\305\276ky do lepidla.\',\n    pStep4Name: \'04 Fin\303\241lna omietka\',\n    pStep4Desc: \'Nanesenie kvalitnej farby a \305\241trukt\303\272rovanej omietky.\',\n    galleryTitle: \'NA\305\240E FAS\303\201DY\'\n  },\n  {\n    oldFile: \'src/pages/Udrzba.tsx\',\n    newFile: \'src/pages/InterierInstalacie.tsx\',\n    componentName: \'InterierInstalacie\',\n    title: \'INTERI\303\211R A IN\305\240TAL\303\201CIE\',\n    titleHtml: \'INTERI\303\211R <br /> <span className=\"text-[#E5A93B]\">A IN\305\240TAL\303\201CIE</span>\',\n    subtitle: \'Voda, kanaliz\303\241cia, k\303\272renie, elektroin\305\241tal\303\241cie, sadrokart\303\263ny a \305\241tukov\303\251 omietky.\',\n    image: \'https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&fit=crop&q=80&w=800\',\n    eyebrow: \'SPO\304\275AHLIV\303\211 IN\305\240TAL\303\201CIE\',\n    h2: \'Srdce v\303\241\305\241ho <br/> <span className=\"text-[#E5A93B]\">nov\303\251ho domova</span>\',\n    p1: \'Spr\303\241vne funguj\303\272ce rozvody s\303\272 k\304\276\303\272\304\215om ku komfortu.\',\n    p2: \'Zabezpe\304\215\303\255me pre v\303\241s kompletn\303\251 elektroin\305\241tal\303\241cie, vodoin\305\241tal\303\241cie, k\303\272renie a kvalitn\303\251 interi\303\251rov\303\251 \303\272pravy pre v\303\241\305\241 maxim\303\241lny komfort.\',\n    featureEyebrow: \'PRE\304\214O NA\305\240E IN\305\240TAL\303\201CIE?\',\n    f1Title: \'BEZPE\304\214NOS\305\244\',\n    f1Desc: \'V\305\241etky in\305\241tal\303\241cie realizujeme s d\303\264razom na pr\303\255sne normy.\',\n    f2Title: \'MODERN\303\211 TECHNOL\303\223GIE\',\n    f2Desc: \'Pracujeme s najnov\305\241\303\255mi syst\303\251mami pre inteligentn\303\251 a \303\272sporn\303\251 dom\303\241cnosti.\',\n    f3Title: \'DOKONAL\303\235 INTERI\303\211R\',\n    f3Desc: \'Od presn\303\275ch sadrokart\303\263nov po prec\303\255zne maliarske pr\303\241ce.\',\n    processEyebrow: \'POSTUP PR\303\201C V INTERI\303\211RI\',\n    processH2: \'Od k\303\241blov <br /> <span className=\"text-[#E5A93B]\">po omietky</span>\',\n    pStep1Name: \'01 Dr\303\241\305\276kovanie\',\n    pStep1Desc: \'Pr\303\255prava tr\303\241s pre rozvody vody, elektriny a k\303\272renia.\',\n    pStep2Name: \'02 In\305\241tal\303\241cie\',\n    pStep2Desc: \'Natiahnutie siet\303\255, trubiek a k\303\241blov v interi\303\251ri.\',\n    pStep3Name: \'03 Sadrokart\303\263ny\',\n    pStep3Desc: \'Mont\303\241\305\276 podh\304\276adov, prie\304\215ok a tepelnej izol\303\241cie.\',\n    pStep4Name: \'04 Omietky a ma\304\276by\',\n    pStep4Desc: \'Fin\303\241lna \303\272prava stien pre dokonal\303\275 hladk\303\275 vzh\304\276ad.\',\n    galleryTitle: \'INTERI\303\211ROV\303\211 PR\303\201CE\'\n  }\n];\n\n// Helper to safely replace text via regex or plain string\nfunction replaceSafely(content, search, replacement) {\n  return content.replace(search, replacement);\n}\n\nfor (const s of services) {\n  if (fs.existsSync(s.oldFile)) {\n    let content = fs.readFileSync(s.oldFile, \'utf-8\');\n\n    // 1. Rename Component Name\n    // Usually it\'s exported as export default function ComponentName()\n    content = content.replace(/export default function \\w+\\(\\)/, `export default function ${s.componentName}()`);\n\n    // 2. Hero Section Replacement (Needs some generic matching)\n    // Find the H1 (Title)\n    content = content.replace(/<h1[^>]*>([\\s\\S]*?)<\\/h1>/, `<h1 className=\"text-[42px] font-extrabold tracking-tight text-white mb-4 uppercase leading-[1.05]\">\\n              ${s.titleHtml}\\n            </h1>`);\n\n    // Find the Hero subtitle\n    content = content.replace(/<p className=\"text-\\[15px\\] text-gray-200 mb-6 font-medium max-w-\\[280px\\] leading-\\[1.6\\]\">([\\s\\S]*?)<\\/p>/, `<p className=\"text-[15px] text-gray-200 mb-6 font-medium max-w-[280px] leading-[1.6]\">\\n              ${s.subtitle}\\n            </p>`);\n\n    // Replace Image\n    content = content.replace(/src=\"https:\\/\\/images.unsplash.com\\/photo[^\"]*\"/, `src=\"${s.image}\"`);\n\n    // Replace first Eyebrow (SEO Intro)\n    content = content.replace(/<span className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">([\\s\\S]*?)<\\/span>/, `<span className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n                ${s.eyebrow}\\n              </span>`);\n\n    // Replace first H2\n    content = content.replace(/<h2 className=\"text-\\[32px\\] font-extrabold text-\\[#1A1A1A\\] leading-\\[1.15\\] mb-7 relative z-10 tracking-tight\">([\\s\\S]*?)<\\/h2>/, `<h2 className=\"text-[32px] font-extrabold text-[#1A1A1A] leading-[1.15] mb-7 relative z-10 tracking-tight\">\\n              ${s.h2}\\n            </h2>`);\n\n    // Replace P1\n    content = content.replace(/<p className=\"text-\\[17px\\] text-\\[#1A1A1A\\] font-bold leading-\\[1.5\\] relative z-10 mb-8 max-w-\\[280px\\]\">([\\s\\S]*?)<\\/p>/, `<p className=\"text-[17px] text-[#1A1A1A] font-bold leading-[1.5] relative z-10 mb-8 max-w-[280px]\">\\n              ${s.p1}\\n            </p>`);\n\n    // Replace P2\n    content = content.replace(/<p className=\"text-\\[15px\\] text-gray-700 font-medium leading-\\[1.6\\] mb-6\">([\\s\\S]*?)<\\/p>/, `<p className=\"text-[15px] text-gray-700 font-medium leading-[1.6] mb-6\">\\n                ${s.p2}\\n              </p>`);\n\n    // Replace Feature Eyebrow (2nd eyebrow)\n    // We can just use string replacements for known parts, or regex for h2 with uppercase tracking-widest\n    const featureRegex = /<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*(?:PRE\304\214O PRAVIDELN\303\211 KOSENIE\\?|PRE\304\214O ODBORN\303\201 STAROSTLIVOS\305\244\\?|PRE\304\214O PRAVIDELN\303\211 STRIHANIE\\?|PRE\304\214O KOMPLETN\303\201 \303\232DR\305\275BA\\?)\\s*<\\/h2>/;\n    content = content.replace(featureRegex, `<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              ${s.featureEyebrow}\\n            </h2>`);\n    \n    // Fallback if the regex doesn\'t match\n    if (!featureRegex.test(content)) {\n        content = content.replace(/PRE\304\214O PRAVIDELN\303\211 KOSENIE\\?/, s.featureEyebrow);\n        content = content.replace(/PRE\304\214O ODBORN\303\201 STAROSTLIVOS\305\244\\?/, s.featureEyebrow);\n        content = content.replace(/PRE\304\214O PRAVIDELN\303\211 STRIHANIE\\?/, s.featureEyebrow);\n        content = content.replace(/PRE\304\214O KOMPLETN\303\201 \303\232DR\305\275BA\\?/, s.featureEyebrow);\n    }\n\n    // Replace Features Text (3 features usually)\n    // We\'ll just replace h3 and p inside the feature cards.\n    const h3Regex = /<h3 className=\"text-\\[14px\\] font-extrabold text-\\[#1A1A1A\\] mb-3 uppercase tracking-wide\">([\\s\\S]*?)<\\/h3>/g;\n    let h3Matches = [...content.matchAll(h3Regex)];\n    if (h3Matches.length >= 3) {\n      content = content.replace(h3Matches[0][0], `<h3 className=\"text-[14px] font-extrabold text-[#1A1A1A] mb-3 uppercase tracking-wide\">${s.f1Title}</h3>`);\n      content = content.replace(h3Matches[1][0], `<h3 className=\"text-[14px] font-extrabold text-[#1A1A1A] mb-3 uppercase tracking-wide\">${s.f2Title}</h3>`);\n      content = content.replace(h3Matches[2][0], `<h3 className=\"text-[14px] font-extrabold text-[#1A1A1A] mb-3 uppercase tracking-wide\">${s.f3Title}</h3>`);\n    }\n\n    const featureDescRegex = /<p className=\"text-\\[14px\\] text-gray-600 leading-\\[1.6\\]\">([\\s\\S]*?)<\\/p>/g;\n    let descMatches = [...content.matchAll(featureDescRegex)];\n    // Typically there are 3 feature descs and maybe some process descs. The first 3 are the features.\n    if (descMatches.length >= 3) {\n      content = content.replace(descMatches[0][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.f1Desc}</p>`);\n      content = content.replace(descMatches[1][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.f2Desc}</p>`);\n      content = content.replace(descMatches[2][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.f3Desc}</p>`);\n    }\n\n\n    // Replace Process Eyebrow\n    content = content.replace(/POSTUP PRI \303\232DR\305\275BE TR\303\201VNIKA|AKO PREBIEHA STAROSTLIVOS\305\244\\?|AKO PREBIEHA STRIHANIE\\?|AKO PREBIEHA \303\232DR\305\275BA\\?/, s.processEyebrow);\n\n    // Replace Process H2\n    content = content.replace(/Od prv\303\251ho kosenia <br \\/>\\s*<span className=\"text-\\[#E5A93B\\]\">po dokonal\303\275 v\303\275sledok<\\/span>|Od n\303\241vrhu po <br \\/>\\s*<span className=\"text-\\[#E5A93B\\]\">dokonal\303\275 v\303\275sledok<\\/span>|Od obhliadky <br \\/>\\s*<span className=\"text-\\[#E5A93B\\]\">k zdrav\303\275m stromom<\\/span>|V\305\241etko pre kr\303\241snu <br \\/>\\s*<span className=\"text-\\[#E5A93B\\]\">z\303\241hradu<\\/span>/, s.processH2);\n\n    // Process Steps\n    const processStepTitleRegex = /<h3 className=\"text-\\[16px\\] font-bold text-\\[#1A1A1A\\] mb-2\">([\\s\\S]*?)<\\/h3>/g;\n    let pTitleMatches = [...content.matchAll(processStepTitleRegex)];\n    if (pTitleMatches.length >= 4) {\n      content = content.replace(pTitleMatches[0][0], `<h3 className=\"text-[16px] font-bold text-[#1A1A1A] mb-2\">${s.pStep1Name}</h3>`);\n      content = content.replace(pTitleMatches[1][0], `<h3 className=\"text-[16px] font-bold text-[#1A1A1A] mb-2\">${s.pStep2Name}</h3>`);\n      content = content.replace(pTitleMatches[2][0], `<h3 className=\"text-[16px] font-bold text-[#1A1A1A] mb-2\">${s.pStep3Name}</h3>`);\n      content = content.replace(pTitleMatches[3][0], `<h3 className=\"text-[16px] font-bold text-[#1A1A1A] mb-2\">${s.pStep4Name}</h3>`);\n    }\n\n    // Note: The process descriptions might be captured in the `featureDescRegex` matches if they use the same class, or they might use a different class. Let\'s check typical class for process desc.\n    const processDescRegex = /<p className=\"text-\\[14px\\] text-gray-600 leading-\\[1.5\\]\">([\\s\\S]*?)<\\/p>/g;\n    let pDescMatches = [...content.matchAll(processDescRegex)];\n    if (pDescMatches.length >= 4) {\n      content = content.replace(pDescMatches[0][0], `<p className=\"text-[14px] text-gray-600 leading-[1.5]\">${s.pStep1Desc}</p>`);\n      content = content.replace(pDescMatches[1][0], `<p className=\"text-[14px] text-gray-600 leading-[1.5]\">${s.pStep2Desc}</p>`);\n      content = content.replace(pDescMatches[2][0], `<p className=\"text-[14px] text-gray-600 leading-[1.5]\">${s.pStep3Desc}</p>`);\n      content = content.replace(pDescMatches[3][0], `<p className=\"text-[14px] text-gray-600 leading-[1.5]\">${s.pStep4Desc}</p>`);\n    } else {\n        // Fallback in case they share the same class as featureDesc (text-gray-600 leading-[1.6])\n        if (descMatches.length >= 7) {\n            content = content.replace(descMatches[3][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.pStep1Desc}</p>`);\n            content = content.replace(descMatches[4][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.pStep2Desc}</p>`);\n            content = content.replace(descMatches[5][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.pStep3Desc}</p>`);\n            content = content.replace(descMatches[6][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.pStep4Desc}</p>`);\n        }\n    }\n\n\n    // Replace CTA pre-footer\n    content = content.replace(/Chcete ma\305\245 tr\303\241vnik <br \\/>\\s*v\305\276dy v perfektnej kond\303\255cii\\?|Zverte svoju z\303\241hradu <br \\/>\\s*do r\303\272k odborn\303\255kom\\.|Potrebuj\303\272 va\305\241e stromy <br \\/>\\s*odborn\303\275 rez\\?|Chcete kr\303\241snu z\303\241hradu <br \\/>\\s*bez n\303\241mahy\\?/g, \'M\303\241te projekt? <br /> Porozpr\303\241vajme sa o \305\210om.\');\n    content = content.replace(/Nez\303\241v\303\244zne n\303\241s kontaktujte\\./g, \'Priprav\303\255me v\303\241m nez\303\241v\303\244zn\303\272 cenov\303\272 ponuku a navrhneme najlep\305\241ie rie\305\241enie pre va\305\241e b\303\275vanie.\');\n\n\n    // Remove old specific items in lists (Spr\303\241vna v\303\275\305\241ka kosenia etc) and replace with generic ones using HardHat, ShieldCheck, Check\n    const ulRegex = /<ul className=\"flex flex-col gap-3\">([\\s\\S]*?)<\\/ul>/;\n    content = content.replace(ulRegex, `<ul className=\"flex flex-col gap-3\">\n                <li className=\"flex items-center gap-3\">\n                  <HardHat className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Sk\303\272sen\303\255 profesion\303\241li</span>\n                </li>\n                <li className=\"flex items-center gap-3\">\n                  <ShieldCheck className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Kvalitn\303\251 materi\303\241ly</span>\n                </li>\n                <li className=\"flex items-center gap-3\">\n                  <Check className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Spokojnos\305\245 z\303\241kazn\303\255kov</span>\n                </li>\n              </ul>`);\n\n    fs.writeFileSync(s.newFile, content);\n  }\n}\nconsole.log(\'Done generating new service pages.\');\nEOF\nnode rewrite_services.cjs"
    proposed_command_line: "cat << \'EOF\' > rewrite_services.cjs\nconst fs = require(\'fs\');\n\nconst services = [\n  {\n    oldFile: \'src/pages/Sluzby.tsx\',\n    newFile: \'src/pages/StavbyNaKluc.tsx\',\n    componentName: \'StavbyNaKluc\',\n    title: \'STAVBY NA K\304\275\303\232\304\214\',\n    titleHtml: \'STAVBY <br /> NA <br /> <span className=\"text-[#E5A93B]\">K\304\275\303\232\304\214</span>\',\n    subtitle: \'Kompletn\303\241 v\303\275stavba rodinn\303\275ch domov od z\303\241kladovej dosky a\305\276 po odovzdanie.\',\n    image: \'https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=800\',\n    eyebrow: \'BEZSTAROSTN\303\201 V\303\235STAVBA\',\n    h2: \'V\303\241\305\241 nov\303\275 domov <br/> <span className=\"text-[#E5A93B]\">bez starost\303\255</span>\',\n    p1: \'Stavba rodinn\303\251ho domu je ve\304\276k\303\275 krok.\',\n    p2: \'Postar\303\241me sa o kompletn\303\272 realiz\303\241ciu od v\303\275kopov a\305\276 po fin\303\241lne odovzdanie k\304\276\303\272\304\215ov. S nami m\303\241te istotu dodr\305\276ania term\303\255nov a rozpo\304\215tu.\',\n    featureEyebrow: \'PRE\304\214O STAVA\305\244 S NAMI?\',\n    f1Title: \'KOMPLETN\303\235 SERVIS\',\n    f1Desc: \'Zastre\305\241\303\255me v\305\241etky procesy a remesl\303\241 na jednom mieste.\',\n    f2Title: \'KVALITN\303\211 MATERI\303\201LY\',\n    f2Desc: \'Pracujeme len s overen\303\275mi stavebn\303\275mi materi\303\241lmi a postupmi.\',\n    f3Title: \'Z\303\201RUKA NA DIELO\',\n    f3Desc: \'Za na\305\241ou pr\303\241cou si stoj\303\255me a poskytujeme pln\303\272 z\303\241ruku na zrealizovan\303\272 stavbu.\',\n    processEyebrow: \'AKO PREBIEHA V\303\235STAVBA\',\n    processH2: \'Od z\303\241kladov <br /> <span className=\"text-[#E5A93B]\">a\305\276 po strechu</span>\',\n    pStep1Name: \'01 Pr\303\255prava\',\n    pStep1Desc: \'Zemn\303\251 pr\303\241ce a vybudovanie pevn\303\275ch z\303\241kladov.\',\n    pStep2Name: \'02 Hrub\303\241 stavba\',\n    pStep2Desc: \'Murovanie, \305\276elezobet\303\263nov\303\251 kon\305\241trukcie a strecha.\',\n    pStep3Name: \'03 In\305\241tal\303\241cie\',\n    pStep3Desc: \'Rozvody vody, elektriny, k\303\272renia a odpadov.\',\n    pStep4Name: \'04 Dokon\304\215enie\',\n    pStep4Desc: \'Omietky, fas\303\241da a fin\303\241lne interi\303\251rov\303\251 \303\272pravy.\',\n    galleryTitle: \'NA\305\240E STAVBY\'\n  },\n  {\n    oldFile: \'src/pages/Starostlivost.tsx\',\n    newFile: \'src/pages/Rekonstrukcie.tsx\',\n    componentName: \'Rekonstrukcie\',\n    title: \'REKON\305\240TRUKCIE\',\n    titleHtml: \'KOMPLETN\303\211 <br /> <span className=\"text-[#E5A93B]\">REKON\305\240TRUKCIE</span>\',\n    subtitle: \'Kompletn\303\251 rekon\305\241trukcie domov a bytov vr\303\241tane prer\303\241bky bytov\303\275ch jadier a k\303\272pe\304\276n\303\255 na k\304\276\303\272\304\215.\',\n    image: \'https://images.unsplash.com/photo-1588854337221-4cfb9264c919?auto=format&fit=crop&q=80&w=800\',\n    eyebrow: \'NOV\303\235 \305\275IVOT PRE V\303\201\305\240 DOMOV\',\n    h2: \'Dajte svojmu domovu <br/> <span className=\"text-[#E5A93B]\">nov\303\275 dych</span>\',\n    p1: \'Rekon\305\241trukcia vy\305\276aduje sk\303\272senosti a cit.\',\n    p2: \'\304\214i u\305\276 ide o rekon\305\241trukciu bytov\303\251ho jadra, k\303\272pe\304\276ne, alebo kompletn\303\272 prestavbu cel\303\251ho domu, sme tu pre v\303\241s.\',\n    featureEyebrow: \'PRE\304\214O REKON\305\240TRUOVA\305\244 S NAMI?\',\n    f1Title: \'SK\303\232SEN\303\235 T\303\215M\',\n    f1Desc: \'Na\305\241i odborn\303\255ci si poradia aj so zlo\305\276it\303\275mi technick\303\275mi rie\305\241eniami.\',\n    f2Title: \'\304\214ISTOTA A PORIADOK\',\n    f2Desc: \'Db\303\241me na to, aby rekon\305\241trukcia \304\215o najmenej obmedzovala okolie.\',\n    f3Title: \'MODERN\303\211 RIE\305\240ENIA\',\n    f3Desc: \'Prin\303\241\305\241ame modern\303\251 materi\303\241ly a overen\303\251 pracovn\303\251 postupy.\',\n    processEyebrow: \'AKO PREBIEHA REKON\305\240TRUKCIA\',\n    processH2: \'Od b\303\272rania <br /> <span className=\"text-[#E5A93B]\">k nov\303\251mu domovu</span>\',\n    pStep1Name: \'01 B\303\272racie pr\303\241ce\',\n    pStep1Desc: \'Bezpe\304\215n\303\251 odstr\303\241nenie star\303\275ch kon\305\241trukci\303\255 a odvoz sutiny.\',\n    pStep2Name: \'02 Nov\303\251 rozvody\',\n    pStep2Desc: \'V\303\275mena in\305\241tal\303\241ci\303\255 pod\304\276a nov\303\275ch \305\241tandardov.\',\n    pStep3Name: \'03 Mur\303\241rske pr\303\241ce\',\n    pStep3Desc: \'Nov\303\251 omietky, sadrokart\303\263ny a stavebn\303\251 \303\272pravy.\',\n    pStep4Name: \'04 Obklady a dla\305\276by\',\n    pStep4Desc: \'Prec\303\255zna pokl\303\241dka s d\303\264razom na ka\305\276d\303\275 detail.\',\n    galleryTitle: \'UK\303\201\305\275KY PR\303\201C\'\n  },\n  {\n    oldFile: \'src/pages/Strihanie.tsx\',\n    newFile: \'src/pages/ExterierFasady.tsx\',\n    componentName: \'ExterierFasady\',\n    title: \'EXTERI\303\211R A FAS\303\201DY\',\n    titleHtml: \'EXTERI\303\211R <br /> <span className=\"text-[#E5A93B]\">A FAS\303\201DY</span>\',\n    subtitle: \'Zatep\304\276ovanie budov, fas\303\241dne \303\272pravy, zemn\303\251 a v\303\275kopov\303\251 pr\303\241ce, pokl\303\241dka dla\305\276by.\',\n    image: \'https://images.unsplash.com/photo-1628624747186-a941c476b7ef?auto=format&fit=crop&q=80&w=800\',\n    eyebrow: \'DOKONAL\303\201 VIZITKA DOMU\',\n    h2: \'Kvalitn\303\241 fas\303\241da, <br/> <span className=\"text-[#E5A93B]\">ktor\303\241 chr\303\241ni</span>\',\n    p1: \'Fas\303\241da nie je len o vzh\304\276ade, ale najm\303\244 o funk\304\215nosti.\',\n    p2: \'Poskytujeme profesion\303\241lne zateplenie a fas\303\241dne \303\272pravy, ktor\303\251 zn\303\255\305\276ia va\305\241e energetick\303\251 n\303\241klady a ochr\303\241nia dom pred vplyvmi po\304\215asia.\',\n    featureEyebrow: \'PRE\304\214O SI VYBRA\305\244 N\303\201S?\',\n    f1Title: \'ENERGETICK\303\201 \303\232SPORA\',\n    f1Desc: \'Kvalitn\303\251 zateplenie v\303\275razne zni\305\276uje n\303\241klady na vykurovanie.\',\n    f2Title: \'OCHRANA STAVBY\',\n    f2Desc: \'Spr\303\241vna fas\303\241da chr\303\241ni murivo pred vlhkos\305\245ou a degrad\303\241ciou.\',\n    f3Title: \'KOMPLEXN\303\235 EXTERI\303\211R\',\n    f3Desc: \'Od fas\303\241dy a\305\276 po z\303\241mkov\303\272 dla\305\276bu a oplotenie.\',\n    processEyebrow: \'AKO PREBIEHA ZATEPLENIE\',\n    processH2: \'Od izol\303\241cie <br /> <span className=\"text-[#E5A93B]\">k omietke</span>\',\n    pStep1Name: \'01 Pr\303\255prava podkladu\',\n    pStep1Desc: \'O\304\215istenie a penetr\303\241cia pre dokonal\303\272 pri\304\276navos\305\245.\',\n    pStep2Name: \'02 Lepenie izolantu\',\n    pStep2Desc: \'Presn\303\251 nanesenie polystyr\303\251nu alebo miner\303\241lnej vaty.\',\n    pStep3Name: \'03 Armovacia vrstva\',\n    pStep3Desc: \'Zaliatie sklotextilnej mrie\305\276ky do lepidla.\',\n    pStep4Name: \'04 Fin\303\241lna omietka\',\n    pStep4Desc: \'Nanesenie kvalitnej farby a \305\241trukt\303\272rovanej omietky.\',\n    galleryTitle: \'NA\305\240E FAS\303\201DY\'\n  },\n  {\n    oldFile: \'src/pages/Udrzba.tsx\',\n    newFile: \'src/pages/InterierInstalacie.tsx\',\n    componentName: \'InterierInstalacie\',\n    title: \'INTERI\303\211R A IN\305\240TAL\303\201CIE\',\n    titleHtml: \'INTERI\303\211R <br /> <span className=\"text-[#E5A93B]\">A IN\305\240TAL\303\201CIE</span>\',\n    subtitle: \'Voda, kanaliz\303\241cia, k\303\272renie, elektroin\305\241tal\303\241cie, sadrokart\303\263ny a \305\241tukov\303\251 omietky.\',\n    image: \'https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&fit=crop&q=80&w=800\',\n    eyebrow: \'SPO\304\275AHLIV\303\211 IN\305\240TAL\303\201CIE\',\n    h2: \'Srdce v\303\241\305\241ho <br/> <span className=\"text-[#E5A93B]\">nov\303\251ho domova</span>\',\n    p1: \'Spr\303\241vne funguj\303\272ce rozvody s\303\272 k\304\276\303\272\304\215om ku komfortu.\',\n    p2: \'Zabezpe\304\215\303\255me pre v\303\241s kompletn\303\251 elektroin\305\241tal\303\241cie, vodoin\305\241tal\303\241cie, k\303\272renie a kvalitn\303\251 interi\303\251rov\303\251 \303\272pravy pre v\303\241\305\241 maxim\303\241lny komfort.\',\n    featureEyebrow: \'PRE\304\214O NA\305\240E IN\305\240TAL\303\201CIE?\',\n    f1Title: \'BEZPE\304\214NOS\305\244\',\n    f1Desc: \'V\305\241etky in\305\241tal\303\241cie realizujeme s d\303\264razom na pr\303\255sne normy.\',\n    f2Title: \'MODERN\303\211 TECHNOL\303\223GIE\',\n    f2Desc: \'Pracujeme s najnov\305\241\303\255mi syst\303\251mami pre inteligentn\303\251 a \303\272sporn\303\251 dom\303\241cnosti.\',\n    f3Title: \'DOKONAL\303\235 INTERI\303\211R\',\n    f3Desc: \'Od presn\303\275ch sadrokart\303\263nov po prec\303\255zne maliarske pr\303\241ce.\',\n    processEyebrow: \'POSTUP PR\303\201C V INTERI\303\211RI\',\n    processH2: \'Od k\303\241blov <br /> <span className=\"text-[#E5A93B]\">po omietky</span>\',\n    pStep1Name: \'01 Dr\303\241\305\276kovanie\',\n    pStep1Desc: \'Pr\303\255prava tr\303\241s pre rozvody vody, elektriny a k\303\272renia.\',\n    pStep2Name: \'02 In\305\241tal\303\241cie\',\n    pStep2Desc: \'Natiahnutie siet\303\255, trubiek a k\303\241blov v interi\303\251ri.\',\n    pStep3Name: \'03 Sadrokart\303\263ny\',\n    pStep3Desc: \'Mont\303\241\305\276 podh\304\276adov, prie\304\215ok a tepelnej izol\303\241cie.\',\n    pStep4Name: \'04 Omietky a ma\304\276by\',\n    pStep4Desc: \'Fin\303\241lna \303\272prava stien pre dokonal\303\275 hladk\303\275 vzh\304\276ad.\',\n    galleryTitle: \'INTERI\303\211ROV\303\211 PR\303\201CE\'\n  }\n];\n\n// Helper to safely replace text via regex or plain string\nfunction replaceSafely(content, search, replacement) {\n  return content.replace(search, replacement);\n}\n\nfor (const s of services) {\n  if (fs.existsSync(s.oldFile)) {\n    let content = fs.readFileSync(s.oldFile, \'utf-8\');\n\n    // 1. Rename Component Name\n    // Usually it\'s exported as export default function ComponentName()\n    content = content.replace(/export default function \\w+\\(\\)/, `export default function ${s.componentName}()`);\n\n    // 2. Hero Section Replacement (Needs some generic matching)\n    // Find the H1 (Title)\n    content = content.replace(/<h1[^>]*>([\\s\\S]*?)<\\/h1>/, `<h1 className=\"text-[42px] font-extrabold tracking-tight text-white mb-4 uppercase leading-[1.05]\">\\n              ${s.titleHtml}\\n            </h1>`);\n\n    // Find the Hero subtitle\n    content = content.replace(/<p className=\"text-\\[15px\\] text-gray-200 mb-6 font-medium max-w-\\[280px\\] leading-\\[1.6\\]\">([\\s\\S]*?)<\\/p>/, `<p className=\"text-[15px] text-gray-200 mb-6 font-medium max-w-[280px] leading-[1.6]\">\\n              ${s.subtitle}\\n            </p>`);\n\n    // Replace Image\n    content = content.replace(/src=\"https:\\/\\/images.unsplash.com\\/photo[^\"]*\"/, `src=\"${s.image}\"`);\n\n    // Replace first Eyebrow (SEO Intro)\n    content = content.replace(/<span className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">([\\s\\S]*?)<\\/span>/, `<span className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n                ${s.eyebrow}\\n              </span>`);\n\n    // Replace first H2\n    content = content.replace(/<h2 className=\"text-\\[32px\\] font-extrabold text-\\[#1A1A1A\\] leading-\\[1.15\\] mb-7 relative z-10 tracking-tight\">([\\s\\S]*?)<\\/h2>/, `<h2 className=\"text-[32px] font-extrabold text-[#1A1A1A] leading-[1.15] mb-7 relative z-10 tracking-tight\">\\n              ${s.h2}\\n            </h2>`);\n\n    // Replace P1\n    content = content.replace(/<p className=\"text-\\[17px\\] text-\\[#1A1A1A\\] font-bold leading-\\[1.5\\] relative z-10 mb-8 max-w-\\[280px\\]\">([\\s\\S]*?)<\\/p>/, `<p className=\"text-[17px] text-[#1A1A1A] font-bold leading-[1.5] relative z-10 mb-8 max-w-[280px]\">\\n              ${s.p1}\\n            </p>`);\n\n    // Replace P2\n    content = content.replace(/<p className=\"text-\\[15px\\] text-gray-700 font-medium leading-\\[1.6\\] mb-6\">([\\s\\S]*?)<\\/p>/, `<p className=\"text-[15px] text-gray-700 font-medium leading-[1.6] mb-6\">\\n                ${s.p2}\\n              </p>`);\n\n    // Replace Feature Eyebrow (2nd eyebrow)\n    // We can just use string replacements for known parts, or regex for h2 with uppercase tracking-widest\n    const featureRegex = /<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*(?:PRE\304\214O PRAVIDELN\303\211 KOSENIE\\?|PRE\304\214O ODBORN\303\201 STAROSTLIVOS\305\244\\?|PRE\304\214O PRAVIDELN\303\211 STRIHANIE\\?|PRE\304\214O KOMPLETN\303\201 \303\232DR\305\275BA\\?)\\s*<\\/h2>/;\n    content = content.replace(featureRegex, `<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              ${s.featureEyebrow}\\n            </h2>`);\n    \n    // Fallback if the regex doesn\'t match\n    if (!featureRegex.test(content)) {\n        content = content.replace(/PRE\304\214O PRAVIDELN\303\211 KOSENIE\\?/, s.featureEyebrow);\n        content = content.replace(/PRE\304\214O ODBORN\303\201 STAROSTLIVOS\305\244\\?/, s.featureEyebrow);\n        content = content.replace(/PRE\304\214O PRAVIDELN\303\211 STRIHANIE\\?/, s.featureEyebrow);\n        content = content.replace(/PRE\304\214O KOMPLETN\303\201 \303\232DR\305\275BA\\?/, s.featureEyebrow);\n    }\n\n    // Replace Features Text (3 features usually)\n    // We\'ll just replace h3 and p inside the feature cards.\n    const h3Regex = /<h3 className=\"text-\\[14px\\] font-extrabold text-\\[#1A1A1A\\] mb-3 uppercase tracking-wide\">([\\s\\S]*?)<\\/h3>/g;\n    let h3Matches = [...content.matchAll(h3Regex)];\n    if (h3Matches.length >= 3) {\n      content = content.replace(h3Matches[0][0], `<h3 className=\"text-[14px] font-extrabold text-[#1A1A1A] mb-3 uppercase tracking-wide\">${s.f1Title}</h3>`);\n      content = content.replace(h3Matches[1][0], `<h3 className=\"text-[14px] font-extrabold text-[#1A1A1A] mb-3 uppercase tracking-wide\">${s.f2Title}</h3>`);\n      content = content.replace(h3Matches[2][0], `<h3 className=\"text-[14px] font-extrabold text-[#1A1A1A] mb-3 uppercase tracking-wide\">${s.f3Title}</h3>`);\n    }\n\n    const featureDescRegex = /<p className=\"text-\\[14px\\] text-gray-600 leading-\\[1.6\\]\">([\\s\\S]*?)<\\/p>/g;\n    let descMatches = [...content.matchAll(featureDescRegex)];\n    // Typically there are 3 feature descs and maybe some process descs. The first 3 are the features.\n    if (descMatches.length >= 3) {\n      content = content.replace(descMatches[0][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.f1Desc}</p>`);\n      content = content.replace(descMatches[1][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.f2Desc}</p>`);\n      content = content.replace(descMatches[2][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.f3Desc}</p>`);\n    }\n\n\n    // Replace Process Eyebrow\n    content = content.replace(/POSTUP PRI \303\232DR\305\275BE TR\303\201VNIKA|AKO PREBIEHA STAROSTLIVOS\305\244\\?|AKO PREBIEHA STRIHANIE\\?|AKO PREBIEHA \303\232DR\305\275BA\\?/, s.processEyebrow);\n\n    // Replace Process H2\n    content = content.replace(/Od prv\303\251ho kosenia <br \\/>\\s*<span className=\"text-\\[#E5A93B\\]\">po dokonal\303\275 v\303\275sledok<\\/span>|Od n\303\241vrhu po <br \\/>\\s*<span className=\"text-\\[#E5A93B\\]\">dokonal\303\275 v\303\275sledok<\\/span>|Od obhliadky <br \\/>\\s*<span className=\"text-\\[#E5A93B\\]\">k zdrav\303\275m stromom<\\/span>|V\305\241etko pre kr\303\241snu <br \\/>\\s*<span className=\"text-\\[#E5A93B\\]\">z\303\241hradu<\\/span>/, s.processH2);\n\n    // Process Steps\n    const processStepTitleRegex = /<h3 className=\"text-\\[16px\\] font-bold text-\\[#1A1A1A\\] mb-2\">([\\s\\S]*?)<\\/h3>/g;\n    let pTitleMatches = [...content.matchAll(processStepTitleRegex)];\n    if (pTitleMatches.length >= 4) {\n      content = content.replace(pTitleMatches[0][0], `<h3 className=\"text-[16px] font-bold text-[#1A1A1A] mb-2\">${s.pStep1Name}</h3>`);\n      content = content.replace(pTitleMatches[1][0], `<h3 className=\"text-[16px] font-bold text-[#1A1A1A] mb-2\">${s.pStep2Name}</h3>`);\n      content = content.replace(pTitleMatches[2][0], `<h3 className=\"text-[16px] font-bold text-[#1A1A1A] mb-2\">${s.pStep3Name}</h3>`);\n      content = content.replace(pTitleMatches[3][0], `<h3 className=\"text-[16px] font-bold text-[#1A1A1A] mb-2\">${s.pStep4Name}</h3>`);\n    }\n\n    // Note: The process descriptions might be captured in the `featureDescRegex` matches if they use the same class, or they might use a different class. Let\'s check typical class for process desc.\n    const processDescRegex = /<p className=\"text-\\[14px\\] text-gray-600 leading-\\[1.5\\]\">([\\s\\S]*?)<\\/p>/g;\n    let pDescMatches = [...content.matchAll(processDescRegex)];\n    if (pDescMatches.length >= 4) {\n      content = content.replace(pDescMatches[0][0], `<p className=\"text-[14px] text-gray-600 leading-[1.5]\">${s.pStep1Desc}</p>`);\n      content = content.replace(pDescMatches[1][0], `<p className=\"text-[14px] text-gray-600 leading-[1.5]\">${s.pStep2Desc}</p>`);\n      content = content.replace(pDescMatches[2][0], `<p className=\"text-[14px] text-gray-600 leading-[1.5]\">${s.pStep3Desc}</p>`);\n      content = content.replace(pDescMatches[3][0], `<p className=\"text-[14px] text-gray-600 leading-[1.5]\">${s.pStep4Desc}</p>`);\n    } else {\n        // Fallback in case they share the same class as featureDesc (text-gray-600 leading-[1.6])\n        if (descMatches.length >= 7) {\n            content = content.replace(descMatches[3][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.pStep1Desc}</p>`);\n            content = content.replace(descMatches[4][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.pStep2Desc}</p>`);\n            content = content.replace(descMatches[5][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.pStep3Desc}</p>`);\n            content = content.replace(descMatches[6][0], `<p className=\"text-[14px] text-gray-600 leading-[1.6]\">${s.pStep4Desc}</p>`);\n        }\n    }\n\n\n    // Replace CTA pre-footer\n    content = content.replace(/Chcete ma\305\245 tr\303\241vnik <br \\/>\\s*v\305\276dy v perfektnej kond\303\255cii\\?|Zverte svoju z\303\241hradu <br \\/>\\s*do r\303\272k odborn\303\255kom\\.|Potrebuj\303\272 va\305\241e stromy <br \\/>\\s*odborn\303\275 rez\\?|Chcete kr\303\241snu z\303\241hradu <br \\/>\\s*bez n\303\241mahy\\?/g, \'M\303\241te projekt? <br /> Porozpr\303\241vajme sa o \305\210om.\');\n    content = content.replace(/Nez\303\241v\303\244zne n\303\241s kontaktujte\\./g, \'Priprav\303\255me v\303\241m nez\303\241v\303\244zn\303\272 cenov\303\272 ponuku a navrhneme najlep\305\241ie rie\305\241enie pre va\305\241e b\303\275vanie.\');\n\n\n    // Remove old specific items in lists (Spr\303\241vna v\303\275\305\241ka kosenia etc) and replace with generic ones using HardHat, ShieldCheck, Check\n    const ulRegex = /<ul className=\"flex flex-col gap-3\">([\\s\\S]*?)<\\/ul>/;\n    content = content.replace(ulRegex, `<ul className=\"flex flex-col gap-3\">\n                <li className=\"flex items-center gap-3\">\n                  <HardHat className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Sk\303\272sen\303\255 profesion\303\241li</span>\n                </li>\n                <li className=\"flex items-center gap-3\">\n                  <ShieldCheck className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Kvalitn\303\251 materi\303\241ly</span>\n                </li>\n                <li className=\"flex items-center gap-3\">\n                  <Check className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Spokojnos\305\245 z\303\241kazn\303\255kov</span>\n                </li>\n              </ul>`);\n\n    fs.writeFileSync(s.newFile, content);\n  }\n}\nconsole.log(\'Done generating new service pages.\');\nEOF\nnode rewrite_services.cjs"
    shell_name: "bash"
  }
}
