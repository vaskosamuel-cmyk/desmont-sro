    command_line: "cat << \'EOF\' > rewrite_home.js\nconst fs = require(\'fs\');\n\nlet homeContent = fs.readFileSync(\'src/pages/Home.tsx\', \'utf-8\');\n\n// Colors\nhomeContent = homeContent.replace(/#405C41/g, \'#E5A93B\'); // Gold\nhomeContent = homeContent.replace(/#78A143/g, \'#E5A93B\'); // Gold\nhomeContent = homeContent.replace(/#6A994E/g, \'#E5A93B\'); // Gold\nhomeContent = homeContent.replace(/#588040/g, \'#D4AF37\'); // Darker Gold\nhomeContent = homeContent.replace(/#2B4029/g, \'#1A1A1A\'); // Charcoal\nhomeContent = homeContent.replace(/#1A2619/g, \'#111111\'); // Dark Footer\nhomeContent = homeContent.replace(/#EBE8DF/g, \'#F5F5F5\'); // Light Grey\nhomeContent = homeContent.replace(/#F4F2EB/g, \'#F5F5F5\'); // Light Grey\n\n// Icons\nhomeContent = homeContent.replace(/Leaf/g, \'HardHat\'); \nhomeContent = homeContent.replace(/Sprout/g, \'Hammer\'); \n\n// Let\'s add the imports we need. We\'ll replace Leaf, ShieldCheck, Clock, Sprout, ThumbsUp with construction ones\nhomeContent = homeContent.replace(\n  /Leaf, ShieldCheck, Clock, Sprout, ThumbsUp, Star, Phone, Mail, MapPin, Facebook, Instagram, Check, Image as ImageIcon/,\n  \"HardHat, ShieldCheck, Clock, Hammer, ThumbsUp, Star, Phone, Mail, MapPin, Facebook, Instagram, Check, Image as ImageIcon, Wrench, Ruler, CheckCircle\"\n);\n\n// SECTION 1: Hero\nhomeContent = homeContent.replace(\n  /Premen\303\255me <br \\/>\\s*<span className=\"text-\\[#E5A93B\\]\">v\303\241\305\241 priestor<\\/span> <br \\/>\\s*na dokonal\303\275/,\n  \'Stavby, ktor\303\251 maj\303\272 <br />\\n              <span className=\"text-[#E5A93B]\">z\303\241klad</span> <br />\\n              v kvalite.\'\n);\nhomeContent = homeContent.replace(\n  /Profesion\303\241lne z\303\241hradn\303\255cke slu\305\276by pre kr\303\241su, ktor\303\272 si zamilujete ka\305\276d\303\275 de\305\210\\./,\n  \'Zrealizujeme v\303\241m b\303\275vanie od prvej my\305\241lienky a\305\276 po odovzdanie k\304\276\303\272\304\215ov. Kompletn\303\251 stavebn\303\251 rie\305\241enia od z\303\241kladov a\305\276 po fin\303\241lne detaily pre Bratislavu a okolie.\'\n);\nhomeContent = homeContent.replace(/Z\303\215SKA\305\244 PONUKU/g, \'NEZ\303\201V\303\204ZN\303\201 CENOV\303\201 PONUKA\');\nhomeContent = homeContent.replace(/Man mowing lawn/, \'Modern construction house\');\nhomeContent = homeContent.replace(/\\/IMG_2648\\.JPG/g, \'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&q=80&w=2000\'); // House\n\n// SECTION 2: Trust Strip -> Advantages replaced below\nhomeContent = homeContent.replace(\n  /Sme odborn\303\255ci na <br \\/>\\s*<span className=\"text-\\[#E5A93B\\]\">va\305\241u z\303\241hradu<\\/span>/,\n  \'Sme odborn\303\255ci na <br />\\n              <span className=\"text-[#E5A93B]\">va\305\241u stavbu</span>\'\n);\nhomeContent = homeContent.replace(\n  /Na\305\241ou v\303\241\305\241\305\210ou je pretv\303\241ra\305\245 vonkaj\305\241ie priestory na n\303\241dhern\303\251 miesta pre \305\276ivot, oddych a rados\305\245\\. Sme t\303\255m sk\303\272sen\303\275ch profesion\303\241lov, ktor\303\255 k va\305\241ej z\303\241hrade pristupuj\303\272 s l\303\241skou a maxim\303\241lnou odbornos\305\245ou\\./,\n  \'Na\305\241ou v\303\241\305\241\305\210ou je pretv\303\241ra\305\245 va\305\241e sny o b\303\275van\303\255 na realitu. Sme t\303\255m sk\303\272sen\303\275ch profesion\303\241lov v stavebn\303\255ctve, ktor\303\255 k va\305\241ej stavbe pristupuj\303\272 s maxim\303\241lnou odbornos\305\245ou a d\303\264razom na detail.\'\n);\nhomeContent = homeContent.replace(/Landscaping professionals/, \'Construction professionals\');\nhomeContent = homeContent.replace(/https:\\/\\/images\\.unsplash\\.com\\/photo-1558661081-3c5b52586689\\?auto=format&fit=crop&q=80&w=800/, \'https://images.unsplash.com/photo-1541888086225-f674ce8824f4?auto=format&fit=crop&q=80&w=800\');\n\n// Services text\nhomeContent = homeContent.replace(\n  /V\305\241etko pre kr\303\241snu <br \\/>\\s*a <span className=\"text-\\[#E5A93B\\]\">zdrav\303\272 z\303\241hradu<\\/span>/,\n  \'V\305\241etko pre va\305\241e <br />\\n              <span className=\"text-[#E5A93B]\">dokonal\303\251 b\303\275vanie</span>\'\n);\nhomeContent = homeContent.replace(\n  /Od pravidelnej \303\272dr\305\276by tr\303\241vnika a\305\276 po kompletn\303\272 starostlivos\305\245 o va\305\241u\\s*z\303\241hradu\\. Postar\303\241me sa o ka\305\276d\303\275 detail\\./,\n  \'Od z\303\241kladovej dosky a\305\276 po fin\303\241lne \303\272pravy interi\303\251ru. Postar\303\241me sa o ka\305\276d\303\275 detail va\305\241ej stavby.\'\n);\n\n// Services items\nhomeContent = homeContent.replace(\n  /const services = \\[([\\s\\S]*?)\\];/,\n  `const services = [\n  {\n    id: \'01\',\n    title: \'Stavby na k\304\276\303\272\304\215\',\n    desc: \'Kompletn\303\241 v\303\275stavba rodinn\303\275ch domov od z\303\241kladovej dosky a\305\276 po odovzdanie. Hrub\303\241 stavba, strechy a in\305\276inierske siete.\',\n    image: \'https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=600\',\n    path: \'/sluzby\'\n  },\n  {\n    id: \'02\',\n    title: \'Rekon\305\241trukcie\',\n    desc: \'Kompletn\303\251 rekon\305\241trukcie domov a bytov vr\303\241tane prer\303\241bky bytov\303\275ch jadier a k\303\272pe\304\276n\303\255 na k\304\276\303\272\304\215.\',\n    image: \'https://images.unsplash.com/photo-1588854337221-4cfb9264c919?auto=format&fit=crop&q=80&w=600\',\n    path: \'/sluzby\'\n  },\n  {\n    id: \'03\',\n    title: \'Exteri\303\251r a Fas\303\241dy\',\n    desc: \'Zatep\304\276ovanie budov, fas\303\241dne \303\272pravy, zemn\303\251 a v\303\275kopov\303\251 pr\303\241ce, pokl\303\241dka dla\305\276by a ter\303\251nne \303\272pravy.\',\n    image: \'https://images.unsplash.com/photo-1628624747186-a941c476b7ef?auto=format&fit=crop&q=80&w=600\',\n    path: \'/sluzby\'\n  },\n  {\n    id: \'04\',\n    title: \'Interi\303\251r a In\305\241tal\303\241cie\',\n    desc: \'Voda, kanaliz\303\241cia, k\303\272renie, elektroin\305\241tal\303\241cie, sadrokart\303\263ny, \305\241tukov\303\251 omietky a maliarske pr\303\241ce.\',\n    image: \'https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&fit=crop&q=80&w=600\',\n    path: \'/sluzby\'\n  }\n];`\n);\n\n// Advantages replaced with Trust Strip logic\nhomeContent = homeContent.replace(\n  /Pre\304\215o si vybra\305\245 <br \\/>\\s*<span className=\"text-\\[#E5A93B\\]\">pr\303\241ve n\303\241s\\?<\\/span>/,\n  \'Ako prebieha <br />\\n              <span className=\"text-[#E5A93B]\">spolupr\303\241ca?</span>\'\n);\nhomeContent = homeContent.replace(\n  /<span className=\"text-xs font-bold tracking-widest text-\\[#E5A93B\\] uppercase mb-1\">\\s*Pre\304\215o my\\s*<\\/span>/,\n  \'<span className=\"text-xs font-bold tracking-widest text-[#E5A93B] uppercase mb-1\">\\n                Postup pr\303\241c\\n              </span>\'\n);\n\nhomeContent = homeContent.replace(\n  /const advantages = \\[([\\s\\S]*?)\\];/,\n  `const advantages = [\n  {\n    icon: Clock,\n    title: \'01 Obhliadka a konzult\303\241cia\',\n    desc: \'Pr\303\255deme na miesto, vypo\304\215ujeme si va\305\241e predstavy a zhodnot\303\255me stav.\',\n  },\n  {\n    icon: Ruler,\n    title: \'02 N\303\241vrh a cenov\303\241 ponuka\',\n    desc: \'Priprav\303\255me v\303\241m transparentn\303\275 rozpo\304\215et a jasn\303\275 harmonogram pr\303\241c.\',\n  },\n  {\n    icon: Hammer,\n    title: \'03 Realiz\303\241cia\',\n    desc: \'Za\304\215neme stava\305\245 alebo rekon\305\241truova\305\245 pod\304\276a dohodnut\303\251ho pl\303\241nu s d\303\264razom na \304\215istotu a kvalitu.\',\n  },\n  {\n    icon: CheckCircle,\n    title: \'04 Odovzdanie a servis\',\n    desc: \'Hotov\303\251 dielo v\303\241m odovzd\303\241me pripraven\303\251 na u\305\276\303\255vanie. T\303\275m v\305\241ak na\305\241a starostlivos\305\245 nekon\304\215\303\255.\',\n  },\n];`\n);\n\n\n// Trust Strip - add it after hero section\nconst trustStrip = `\n        {/* Trust Strip */}\n        <section className=\"bg-[#1A1A1A] py-8 px-6 text-white relative z-20\">\n          <div className=\"flex flex-col gap-6\">\n            <div className=\"flex items-center gap-4\">\n              <ShieldCheck className=\"w-8 h-8 text-[#E5A93B] shrink-0\" />\n              <div>\n                <h4 className=\"font-bold text-[15px]\">Kvalita na prvom mieste</h4>\n                <p className=\"text-[13px] text-gray-400\">Poctiv\303\241 pr\303\241ca so z\303\241rukou.</p>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-4\">\n              <HardHat className=\"w-8 h-8 text-[#E5A93B] shrink-0\" />\n              <div>\n                <h4 className=\"font-bold text-[15px]\">Sk\303\272sen\303\275 t\303\255m</h4>\n                <p className=\"text-[13px] text-gray-400\">Odborn\303\255ci s dlhoro\304\215nou praxou.</p>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-4\">\n              <Clock className=\"w-8 h-8 text-[#E5A93B] shrink-0\" />\n              <div>\n                <h4 className=\"font-bold text-[15px]\">Dodr\305\276iavame term\303\255ny</h4>\n                <p className=\"text-[13px] text-gray-400\">Va\305\241a stavba odovzdan\303\241 na\304\215as.</p>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-4\">\n              <ThumbsUp className=\"w-8 h-8 text-[#E5A93B] shrink-0\" />\n              <div>\n                <h4 className=\"font-bold text-[15px]\">F\303\251rov\303\275 pr\303\255stup</h4>\n                <p className=\"text-[13px] text-gray-400\">Transparentn\303\251 ceny bez skryt\303\275ch poplatkov.</p>\n              </div>\n            </div>\n          </div>\n        </section>\n`;\nhomeContent = homeContent.replace(/(<section className=\"py-12 px-6\">)/, trustStrip + \'\\n        $1\');\n\n\n// Before and After section -> modify text\nhomeContent = homeContent.replace(/Z\303\241hrada po \303\272prave/g, \'Dom po rekon\305\241trukcii\');\nhomeContent = homeContent.replace(/Z\303\241hrada pred \303\272pravou/g, \'Dom pred rekon\305\241trukciou\');\nhomeContent = homeContent.replace(\n  /Pozrite sa na re\303\241lne z\303\241hrady na\305\241ich klientov pred a po na\305\241ej starostlivosti\\./,\n  \'Pozrite sa na re\303\241lne projekty na\305\241ich klientov pred a po na\305\241ej rekon\305\241trukcii.\'\n);\n\n// Editorial Transition\nhomeContent = homeContent.replace(/KR\303\201SNA Z\303\201HRADA ZA\304\214\303\215NA PRAVIDELNOU STAROSTLIVOS\305\244OU\\./, \'KVALITN\303\201 STAVBA ZA\304\214\303\215NA POCTIVOU PR\303\201COU A ODBORNOS\305\244OU.\');\nhomeContent = homeContent.replace(/My sa postar\303\241me o to, aby ste sa z nej mohli te\305\241i\305\245 ka\305\276d\303\275 de\305\210\\./, \'My sa postar\303\241me o to, aby ste vo svojom novom domove mohli \305\276i\305\245 bez starost\303\255.\');\n\n// CTA pre-footer\nhomeContent = homeContent.replace(/Chcete ma\305\245 tr\303\241vnik <br \\/>\\s*v\305\276dy v perfektnej kond\303\255cii\\?/, \'M\303\241te projekt? <br /> Porozpr\303\241vajme sa o \305\210om.\');\nhomeContent = homeContent.replace(/Nez\303\241v\303\244zne n\303\241s kontaktujte\\./, \'Priprav\303\255me v\303\241m nez\303\241v\303\244zn\303\272 cenov\303\272 ponuku a navrhneme najlep\305\241ie rie\305\241enie pre va\305\241e b\303\275vanie.\');\nhomeContent = homeContent.replace(\n  /Chcete <span className=\"text-\\[#E5A93B\\]\">kr\303\241snej\305\241iu<\\/span> <br \\/>z\303\241hradu\\?/,\n  \'Pl\303\241nujete <span className=\"text-[#E5A93B]\">stava\305\245</span> <br />alebo rekon\305\241truova\305\245?\'\n);\nhomeContent = homeContent.replace(\n  /Vypl\305\210te kr\303\241tky formul\303\241r a my sa v\303\241m ozveme s nez\303\241v\303\244znou cenovou ponukou na mieru\\./,\n  \'Vypl\305\210te formul\303\241r a my sa v\303\241m ozveme s nez\303\241v\303\244znou cenovou ponukou na mieru.\'\n);\n\n// Final Form\nhomeContent = homeContent.replace(/<option value=\"kosenie\">Kosenie a \303\272dr\305\276ba tr\303\241vnika<\\/option>/, \'<option value=\"stavba\">Stavba na k\304\276\303\272\304\215</option>\');\nhomeContent = homeContent.replace(/<option value=\"strihanie\">Strihanie stromov a plotov<\\/option>/, \'<option value=\"rekonstrukcia\">Rekon\305\241trukcia</option>\');\nhomeContent = homeContent.replace(/<option value=\"kompletna\">Kompletn\303\241 \303\272dr\305\276ba z\303\241hrady<\\/option>/, \'<option value=\"exterier\">Exteri\303\251r a fas\303\241dy</option>\');\n\n\n// Gallery Items\nhomeContent = homeContent.replace(\n  /const galleryItems = \\[([\\s\\S]*?)\\];/,\n  `const galleryItems = [\n  {\n    id: 1,\n    title: \'Rodinn\303\275 dom \342\200\223 Z\303\241horsk\303\241 Bystrica\',\n    desc: \'Kompletn\303\241 v\303\275stavba rodinn\303\251ho domu na k\304\276\303\272\304\215.\',\n    image: \'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&q=80&w=800\',\n  },\n  {\n    id: 2,\n    title: \'Rekon\305\241trukcia bytu \342\200\223 Ru\305\276inov\',\n    desc: \'Kompletn\303\241 prer\303\241bka interi\303\251ru vr\303\241tane jadra a in\305\241tal\303\241ci\303\255.\',\n    image: \'https://images.unsplash.com/photo-1484154218962-a197022b5858?auto=format&fit=crop&q=80&w=800\',\n  },\n  {\n    id: 3,\n    title: \'Fas\303\241da a exteri\303\251r \342\200\223 Dev\303\255nska Nov\303\241 Ves\',\n    desc: \'Zateplenie, fas\303\241dna omietka a ter\303\251nne \303\272pravy okolia domu.\',\n    image: \'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&q=80&w=800\',\n  }\n];`\n);\n\n// Reviews\nhomeContent = homeContent.replace(\n  /const reviews = \\[([\\s\\S]*?)\\];/,\n  `const reviews = [\n  {\n    id: 1,\n    name: \'Martin K.\',\n    location: \'Bratislava\',\n    text: \'Profesion\303\241lny pr\303\255stup od za\304\215iatku do konca. V\305\241etko prebehlo pod\304\276a dohody a v\303\275sledok je skvel\303\275.\',\n  },\n  {\n    id: 2,\n    name: \'Lucia B.\',\n    location: \'Ru\305\276inov\',\n    text: \'Rekon\305\241trukcia k\303\272pe\304\276ne dopadla lep\305\241ie, ako sme \304\215akali. \304\214ist\303\241 pr\303\241ca, odpor\303\272\304\215am ka\305\276d\303\251mu.\',\n  },\n  {\n    id: 3,\n    name: \'Peter M.\',\n    location: \'Z\303\241horsk\303\241 Bystrica\',\n    text: \'F\303\251rov\303\251 jednanie, dodr\305\276an\303\275 rozpo\304\215et aj term\303\255n. Pri \304\217al\305\241ej stavbe ur\304\215ite oslov\303\255m op\303\244\305\245.\',\n  }\n];`\n);\n\n\n// Locations text update\nhomeContent = homeContent.replace(/Na\305\241e z\303\241hradn\303\255cke slu\305\276by poskytujeme preva\305\276ne v Bratislavskom a Trnavskom kraji\\./, \'Na\305\241e stavebn\303\251 slu\305\276by poskytujeme preva\305\276ne v Bratislavskom a Trnavskom kraji.\');\n\n// Footer updates\nhomeContent = homeContent.replace(/Z\303\241hrada s\\.r\\.o\\./g, \'DESMO STAV, spol. s r.o.\');\nhomeContent = homeContent.replace(/info@zahrada\\.sk/g, \'info@desmostav.sk\');\nhomeContent = homeContent.replace(/\\+421 900 123 456/g, \'+421 907 673 697\');\nhomeContent = homeContent.replace(/0905 123 456/g, \'+421 907 673 697\');\nhomeContent = homeContent.replace(/Krajinsk\303\241 30, 821 06 Bratislava/, \'Krajinsk\303\241 30, 821 06 Bratislava\'); // Ensure address is correct\n// Need to add address if not present or replace existing MapPin text\nhomeContent = homeContent.replace(/<span className=\"leading-relaxed\">P\303\264sob\303\255me v<br\\/>Bratislavskom a Trnavskom kraji<\\/span>/, \'<span className=\"leading-relaxed\">Krajinsk\303\241 30,<br/>821 06 Bratislava</span>\');\n\n// FAQs\nhomeContent = homeContent.replace(\n  /const faqs = \\[([\\s\\S]*?)\\];/,\n  `const faqs = [\n  {\n    q: \"Poskytujete obhliadku a cenov\303\272 ponuku zadarmo?\",\n    a: \"\303\201no, prvotn\303\241 obhliadka a vypracovanie nez\303\241v\303\244znej cenovej ponuky s\303\272 u n\303\241s zdarma.\"\n  },\n  {\n    q: \"Ako dlho trv\303\241 stavba rodinn\303\251ho domu na k\304\276\303\272\304\215?\",\n    a: \"Z\303\241vis\303\255 to od n\303\241ro\304\215nosti a ve\304\276kosti projektu, no zvy\304\215ajne to trv\303\241 6 a\305\276 12 mesiacov.\"\n  },\n  {\n    q: \"Pracujete aj cez v\303\255kendy?\",\n    a: \"\303\201no, ak to situ\303\241cia a term\303\255ny vy\305\276aduj\303\272, vieme sa dohodn\303\272\305\245 aj na pr\303\241cach cez v\303\255kend.\"\n  },\n  {\n    q: \"Zabezpe\304\215ujete aj n\303\241kup a dovoz materi\303\241lu?\",\n    a: \"Samozrejme, zabezpe\304\215\303\255me kompletn\303\275 materi\303\241l vr\303\241tane dovozu, aby ste vy nemali \305\276iadne starosti.\"\n  }\n];`\n);\n\nfs.writeFileSync(\'src/pages/Home.tsx\', homeContent);\nconsole.log(\'Done rewriting Home.tsx\');\nEOF\nnode rewrite_home.js\n"
