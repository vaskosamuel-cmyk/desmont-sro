    command_line: "cat << \'EOF\' > update_subservices.cjs\nconst fs = require(\'fs\');\n\nconst files = [\n  \'src/pages/StavbyNaKluc.tsx\',\n  \'src/pages/Rekonstrukcie.tsx\',\n  \'src/pages/ExterierFasady.tsx\',\n  \'src/pages/InterierInstalacie.tsx\'\n];\n\nfor (const file of files) {\n  let content = fs.readFileSync(file, \'utf-8\');\n\n  // 1 & 2. Remove the first short <p> under the H2. \n  // It usually looks like this: <p className=\"text-[17px] text-[#1A1A1A] font-bold leading-[1.5] relative z-10 mb-8 max-w-[280px]\"> ... </p>\n  // We can just use a regex to match it.\n  content = content.replace(/<p className=\"text-\\[17px\\] text-\\[#1A1A1A\\] font-bold leading-\\[1\\.5\\] relative z-10 mb-8 max-w-\\[280px\\]\">[\\s\\S]*?<\\/p>/, \'\');\n\n  // 3. Remove Before and After slider\n  content = content.replace(/\\{\\/\\* Before and After Section \\*\\/\\}[\\s\\S]*?(?=\\{\\/\\* Gallery \\*\\/|\\{\\/\\* FAQs \\*\\/})/g, \'\');\n\n  // 4. Change feature eyebrow to \"PRE\304\214O T\303\201TO SLU\305\275BA?\"\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*PRE\304\214O STAVA\305\244 S NAMI\\?\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              PRE\304\214O T\303\201TO SLU\305\275BA?\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*PRE\304\214O REKON\305\240TRUOVA\305\244 S NAMI\\?\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              PRE\304\214O T\303\201TO SLU\305\275BA?\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*PRE\304\214O SI VYBRA\305\244 N\303\201S\\?\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              PRE\304\214O T\303\201TO SLU\305\275BA?\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*PRE\304\214O NA\305\240E IN\305\240TAL\303\201CIE\\?\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              PRE\304\214O T\303\201TO SLU\305\275BA?\\n            </h2>\');\n\n  // 5. Make gallery title UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*NA\305\240E STAVBY\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*UK\303\201\305\275KY PR\303\201C\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*NA\305\240E FAS\303\201DY\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*INTERI\303\211ROV\303\211 PR\303\201CE\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\\n            </h2>\');\n\n  // 6. Remove Editorial Transition section entirely\n  content = content.replace(/\\{\\/\\* Editorial Transition \\*\\/\\}[\\s\\S]*?(?=\\{\\/\\* CTA \\*\\/})/g, \'\');\n  \n  // Bonus: Fix the hover background in the CTA button from green (#4a6b36) to black or darker gold (#b0912d)\n  content = content.replace(/hover:bg-\\[#4a6b36\\]/g, \'hover:bg-[#111111]\');\n\n  fs.writeFileSync(file, content);\n}\n\nconsole.log(\'Update completed\');\nEOF\nnode update_subservices.cjs"
    proposed_command_line: "cat << \'EOF\' > update_subservices.cjs\nconst fs = require(\'fs\');\n\nconst files = [\n  \'src/pages/StavbyNaKluc.tsx\',\n  \'src/pages/Rekonstrukcie.tsx\',\n  \'src/pages/ExterierFasady.tsx\',\n  \'src/pages/InterierInstalacie.tsx\'\n];\n\nfor (const file of files) {\n  let content = fs.readFileSync(file, \'utf-8\');\n\n  // 1 & 2. Remove the first short <p> under the H2. \n  // It usually looks like this: <p className=\"text-[17px] text-[#1A1A1A] font-bold leading-[1.5] relative z-10 mb-8 max-w-[280px]\"> ... </p>\n  // We can just use a regex to match it.\n  content = content.replace(/<p className=\"text-\\[17px\\] text-\\[#1A1A1A\\] font-bold leading-\\[1\\.5\\] relative z-10 mb-8 max-w-\\[280px\\]\">[\\s\\S]*?<\\/p>/, \'\');\n\n  // 3. Remove Before and After slider\n  content = content.replace(/\\{\\/\\* Before and After Section \\*\\/\\}[\\s\\S]*?(?=\\{\\/\\* Gallery \\*\\/|\\{\\/\\* FAQs \\*\\/})/g, \'\');\n\n  // 4. Change feature eyebrow to \"PRE\304\214O T\303\201TO SLU\305\275BA?\"\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*PRE\304\214O STAVA\305\244 S NAMI\\?\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              PRE\304\214O T\303\201TO SLU\305\275BA?\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*PRE\304\214O REKON\305\240TRUOVA\305\244 S NAMI\\?\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              PRE\304\214O T\303\201TO SLU\305\275BA?\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*PRE\304\214O SI VYBRA\305\244 N\303\201S\\?\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              PRE\304\214O T\303\201TO SLU\305\275BA?\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*PRE\304\214O NA\305\240E IN\305\240TAL\303\201CIE\\?\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              PRE\304\214O T\303\201TO SLU\305\275BA?\\n            </h2>\');\n\n  // 5. Make gallery title UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*NA\305\240E STAVBY\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*UK\303\201\305\275KY PR\303\201C\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*NA\305\240E FAS\303\201DY\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\\n            </h2>\');\n  content = content.replace(/<h2 className=\"text-\\[14px\\] font-extrabold tracking-widest text-\\[#E5A93B\\] uppercase\">\\s*INTERI\303\211ROV\303\211 PR\303\201CE\\s*<\\/h2>/, \'<h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\\n              UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\\n            </h2>\');\n\n  // 6. Remove Editorial Transition section entirely\n  content = content.replace(/\\{\\/\\* Editorial Transition \\*\\/\\}[\\s\\S]*?(?=\\{\\/\\* CTA \\*\\/})/g, \'\');\n  \n  // Bonus: Fix the hover background in the CTA button from green (#4a6b36) to black or darker gold (#b0912d)\n  content = content.replace(/hover:bg-\\[#4a6b36\\]/g, \'hover:bg-[#111111]\');\n\n  fs.writeFileSync(file, content);\n}\n\nconsole.log(\'Update completed\');\nEOF\nnode update_subservices.cjs"
    shell_name: "bash"
  }
}
