    command_line: "cat << \'EOF\' > rewrite_topnav.cjs\nconst fs = require(\'fs\');\n\nlet topnav = fs.readFileSync(\'src/components/TopNav.tsx\', \'utf-8\');\n\n// Colors\ntopnav = topnav.replace(/#1A2619/g, \'#111111\');\ntopnav = topnav.replace(/#78A143/g, \'#E5A93B\');\ntopnav = topnav.replace(/#2B4029/g, \'#1A1A1A\');\ntopnav = topnav.replace(/#1e251d/g, \'#111111\');\ntopnav = topnav.replace(/#253023/g, \'#1A1A1A\');\ntopnav = topnav.replace(/#181d17/g, \'#111111\');\ntopnav = topnav.replace(/#243022/g, \'#1A1A1A\');\ntopnav = topnav.replace(/#303e2d/g, \'#111111\');\n\n// Text\ntopnav = topnav.replace(/Z\303\241hrada<br\\/>Na mieru/g, \'DESMO<br/>STAV\');\ntopnav = topnav.replace(/Z\303\241hrada/g, \'Desmo\');\ntopnav = topnav.replace(/0905 123 456/g, \'0907 673 697\');\ntopnav = topnav.replace(/tel:0905123456/g, \'tel:+421907673697\');\n\n// Icons\ntopnav = topnav.replace(\n  /Leaf, Phone, Menu, X, Home, Sprout, Image as ImageIcon,/,\n  \"HardHat, Phone, Menu, X, Home, Hammer, Image as ImageIcon,\"\n);\ntopnav = topnav.replace(/<Leaf/g, \'<HardHat\');\ntopnav = topnav.replace(/Sprout/g, \'Hammer\');\n\n// Service dropdown\ntopnav = topnav.replace(/\\/kosenie/g, \'/sluzby\');\ntopnav = topnav.replace(/Kosenie a \303\272dr\305\276ba/g, \'Stavby na k\304\276\303\272\304\215\');\n\ntopnav = topnav.replace(/\\/starostlivost/g, \'/sluzby\');\ntopnav = topnav.replace(/Starostlivos\305\245 o z\303\241hradu/g, \'Rekon\305\241trukcie\');\n\ntopnav = topnav.replace(/\\/strihanie/g, \'/sluzby\');\ntopnav = topnav.replace(/Strihanie stromov/g, \'Exteri\303\251r a Fas\303\241dy\');\n\ntopnav = topnav.replace(/\\/udrzba/g, \'/sluzby\');\ntopnav = topnav.replace(/Kompletn\303\241 \303\272dr\305\276ba/g, \'Interi\303\251r a In\305\241tal\303\241cie\');\n\nfs.writeFileSync(\'src/components/TopNav.tsx\', topnav);\nconsole.log(\'Done rewriting TopNav.tsx\');\nEOF\nnode rewrite_topnav.cjs\n"
    proposed_command_line: "cat << \'EOF\' > rewrite_topnav.cjs\nconst fs = require(\'fs\');\n\nlet topnav = fs.readFileSync(\'src/components/TopNav.tsx\', \'utf-8\');\n\n// Colors\ntopnav = topnav.replace(/#1A2619/g, \'#111111\');\ntopnav = topnav.replace(/#78A143/g, \'#E5A93B\');\ntopnav = topnav.replace(/#2B4029/g, \'#1A1A1A\');\ntopnav = topnav.replace(/#1e251d/g, \'#111111\');\ntopnav = topnav.replace(/#253023/g, \'#1A1A1A\');\ntopnav = topnav.replace(/#181d17/g, \'#111111\');\ntopnav = topnav.replace(/#243022/g, \'#1A1A1A\');\ntopnav = topnav.replace(/#303e2d/g, \'#111111\');\n\n// Text\ntopnav = topnav.replace(/Z\303\241hrada<br\\/>Na mieru/g, \'DESMO<br/>STAV\');\ntopnav = topnav.replace(/Z\303\241hrada/g, \'Desmo\');\ntopnav = topnav.replace(/0905 123 456/g, \'0907 673 697\');\ntopnav = topnav.replace(/tel:0905123456/g, \'tel:+421907673697\');\n\n// Icons\ntopnav = topnav.replace(\n  /Leaf, Phone, Menu, X, Home, Sprout, Image as ImageIcon,/,\n  \"HardHat, Phone, Menu, X, Home, Hammer, Image as ImageIcon,\"\n);\ntopnav = topnav.replace(/<Leaf/g, \'<HardHat\');\ntopnav = topnav.replace(/Sprout/g, \'Hammer\');\n\n// Service dropdown\ntopnav = topnav.replace(/\\/kosenie/g, \'/sluzby\');\ntopnav = topnav.replace(/Kosenie a \303\272dr\305\276ba/g, \'Stavby na k\304\276\303\272\304\215\');\n\ntopnav = topnav.replace(/\\/starostlivost/g, \'/sluzby\');\ntopnav = topnav.replace(/Starostlivos\305\245 o z\303\241hradu/g, \'Rekon\305\241trukcie\');\n\ntopnav = topnav.replace(/\\/strihanie/g, \'/sluzby\');\ntopnav = topnav.replace(/Strihanie stromov/g, \'Exteri\303\251r a Fas\303\241dy\');\n\ntopnav = topnav.replace(/\\/udrzba/g, \'/sluzby\');\ntopnav = topnav.replace(/Kompletn\303\241 \303\272dr\305\276ba/g, \'Interi\303\251r a In\305\241tal\303\241cie\');\n\nfs.writeFileSync(\'src/components/TopNav.tsx\', topnav);\nconsole.log(\'Done rewriting TopNav.tsx\');\nEOF\nnode rewrite_topnav.cjs\n"
