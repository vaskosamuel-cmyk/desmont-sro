    command_line: "cat << \'EOF\' > generate_services.cjs\nconst fs = require(\'fs\');\nconst path = require(\'path\');\n\nconst services = [\n  {\n    file: \'src/pages/StavbyNaKluc.tsx\',\n    componentName: \'StavbyNaKluc\',\n    title: \'Stavby na k\304\276\303\272\304\215\',\n    subtitle: \'Od z\303\241kladov a\305\276 po odovzdanie k\304\276\303\272\304\215ov.\',\n    eyebrow: \'BEZSTAROSTN\303\201 V\303\235STAVBA\',\n    introText: \'Postar\303\241me sa o kompletn\303\272 realiz\303\241ciu od v\303\275kopov a\305\276 po fin\303\241lne odovzdanie k\304\276\303\272\304\215ov. S nami m\303\241te istotu dodr\305\276ania term\303\255nov a rozpo\304\215tu.\',\n    bgImg: \'https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'V\303\275kopov\303\251 a z\303\241kladov\303\251 pr\303\241ce\',\n      \'Hrub\303\241 stavba a murovanie\',\n      \'Stre\305\241n\303\251 kon\305\241trukcie a krytiny\',\n      \'Rozvody, in\305\241tal\303\241cie a omietky\',\n      \'Fin\303\241lne povrchov\303\251 \303\272pravy\'\n    ],\n    carousel: [\n      { title: \'KOMPLETN\303\235 SERVIS\', text: \'Od n\303\241vrhu a\305\276 po realiz\303\241ciu zastre\305\241\303\255me v\305\241etko my.\', icon: \'HardHat\' },\n      { title: \'KVALITN\303\211 MATERI\303\201LY\', text: \'Pou\305\276\303\255vame len overen\303\251 a certifikovan\303\251 stavebn\303\251 materi\303\241ly.\', icon: \'ShieldCheck\' },\n      { title: \'Z\303\201RUKA NA DIELO\', text: \'Na na\305\241e stavby poskytujeme pln\303\272 garanciu a z\303\241ru\304\215n\303\275 servis.\', icon: \'Check\' }\n    ],\n    faqs: [\n      { q: \'Ako dlho trv\303\241 stavba domu na k\304\276\303\272\304\215?\', a: \'Od z\303\255skania povolen\303\255 zvy\304\215ajne 8 a\305\276 12 mesiacov v z\303\241vislosti od n\303\241ro\304\215nosti.\' },\n      { q: \'Vybavujete aj stavebn\303\251 povolenie?\', a: \'\303\201no, v r\303\241mci kompletnej slu\305\276by vieme zabezpe\304\215i\305\245 aj in\305\276iniering a povolenia.\' },\n      { q: \'M\303\264\305\276em po\304\215as stavby meni\305\245 materi\303\241ly?\', a: \'Ur\304\215it\303\251 zmeny s\303\272 mo\305\276n\303\251 po vz\303\241jomnej konzult\303\241cii a \303\272prave rozpo\304\215tu.\' },\n      { q: \'Ak\303\251 materi\303\241ly pou\305\276\303\255vate naj\304\215astej\305\241ie?\', a: \'Pracujeme s tehlou, p\303\263robet\303\263nom a preferujeme certifikovan\303\251 zatep\304\276ovacie syst\303\251my.\' }\n    ]\n  },\n  {\n    file: \'src/pages/Rekonstrukcie.tsx\',\n    componentName: \'Rekonstrukcie\',\n    title: \'Rekon\305\241trukcie\',\n    subtitle: \'Nov\303\275 dych pre v\303\241\305\241 star\305\241\303\255 domov.\',\n    eyebrow: \'NOV\303\235 \305\275IVOT PRE V\303\201\305\240 DOMOV\',\n    introText: \'Kompletn\303\251 a \304\215iasto\304\215n\303\251 rekon\305\241trukcie domov a bytov s d\303\264razom na detaily a zachovanie charakteru stavby.\',\n    bgImg: \'https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'B\303\272racie a demola\304\215n\303\251 pr\303\241ce\',\n      \'\303\232prava dispoz\303\255cie a prie\304\215ok\',\n      \'V\303\275mena elektrick\303\275ch a vodovodn\303\275ch rozvodov\',\n      \'Stierkovanie, ma\304\276ovanie a obklady\',\n      \'Pokl\303\241dka podl\303\241h a dver\303\255\'\n    ],\n    carousel: [\n      { title: \'ODBORN\303\211 PORADENSTVO\', text: \'Navrhneme najlep\305\241ie rie\305\241enie pre va\305\241u rekon\305\241trukciu.\', icon: \'HardHat\' },\n      { title: \'MODERNIZ\303\201CIA\', text: \'Zv\303\275\305\241ime energetick\303\272 efektivitu a hodnotu va\305\241ej nehnute\304\276nosti.\', icon: \'Sparkles\' },\n      { title: \'\304\214ISTOTA PRI PR\303\201CI\', text: \'Po\304\215as rekon\305\241trukcie db\303\241me na poriadok a oh\304\276aduplnos\305\245.\', icon: \'Check\' }\n    ],\n    faqs: [\n      { q: \'Zabezpe\304\215ujete aj odvoz stavebn\303\251ho odpadu?\', a: \'\303\201no, kompletn\303\275 odvoz a likvid\303\241cia sutiny je s\303\272\304\215as\305\245ou na\305\241ich slu\305\276ieb.\' },\n      { q: \'Ako dlho trv\303\241 rekon\305\241trukcia bytov\303\251ho jadra?\', a: \'V\303\244\304\215\305\241inou 10 a\305\276 14 pracovn\303\275ch dn\303\255 pod\304\276a zlo\305\276itosti pr\303\241c.\' },\n      { q: \'Potrebujem na rekon\305\241trukciu povolenie?\', a: \'Pri z\303\241sahu do nosn\303\275ch kon\305\241trukci\303\255 \303\241no, pri be\305\276n\303\275ch \303\272prav\303\241ch sta\304\215\303\255 ohl\303\241\305\241ka.\' }\n    ]\n  },\n  {\n    file: \'src/pages/ExterierFasady.tsx\',\n    componentName: \'ExterierFasady\',\n    title: \'Exteri\303\251r a fas\303\241dy\',\n    subtitle: \'Kr\303\241sna a funk\304\215n\303\241 tv\303\241r v\303\241\305\241ho domu.\',\n    eyebrow: \'DOKONAL\303\201 VIZITKA DOMU\',\n    introText: \'Zabezpe\304\215\303\255me zateplenie, nov\303\251 fas\303\241dy a \303\272pravu exteri\303\251ru pre lep\305\241iu ochranu a vzh\304\276ad va\305\241ej nehnute\304\276nosti.\',\n    bgImg: \'https://images.unsplash.com/photo-1589939705384-5185137a7f0f?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'Zatep\304\276ovanie fas\303\241d (EPS, miner\303\241lna vlna)\',\n      \'Aplik\303\241cia u\305\241\304\276achtil\303\275ch omietok\',\n      \'Fas\303\241dne obklady a dekorat\303\255vne prvky\',\n      \'V\303\275stavba plotov a oporn\303\275ch m\303\272rov\',\n      \'Z\303\241mkov\303\251 dla\305\276by a terasy\'\n    ],\n    carousel: [\n      { title: \'\303\232SPORA ENERGI\303\215\', text: \'Kvalitn\303\251 zateplenie v\303\275razne zn\303\255\305\276i va\305\241e n\303\241klady na vykurovanie.\', icon: \'ShieldCheck\' },\n      { title: \'OCHRANA STAVBY\', text: \'Fas\303\241da chr\303\241ni dom pred poveternostn\303\275mi vplyvmi a vlhkos\305\245ou.\', icon: \'HardHat\' },\n      { title: \'ESTETICK\303\235 VZH\304\275AD\', text: \'Modern\303\251 materi\303\241ly dodaj\303\272 v\303\241\305\241mu domu exkluz\303\255vny charakter.\', icon: \'Sparkles\' }\n    ],\n    faqs: [\n      { q: \'Kedy je najlep\305\241\303\255 \304\215as na zatep\304\276ovanie?\', a: \'Ide\303\241lne s\303\272 jarn\303\251 a jesenn\303\251 mesiace, ke\304\217 teploty neklesaj\303\272 pod 5\302\260C a nie s\303\272 hor\303\272\304\215avy.\' },\n      { q: \'Ak\303\275 izolant je najlep\305\241\303\255?\', a: \'Z\303\241le\305\276\303\255 na type muriva, naj\304\215astej\305\241ie pou\305\276\303\255vame polystyr\303\251n alebo miner\303\241lnu vlnu pre lep\305\241iu priedu\305\241nos\305\245.\' },\n      { q: \'Poskytujete aj vizualiz\303\241cie fas\303\241d?\', a: \'Pri rozsiahlej\305\241\303\255ch realiz\303\241ci\303\241ch vieme zabezpe\304\215i\305\245 farebn\303\275 n\303\241vrh.\' }\n    ]\n  },\n  {\n    file: \'src/pages/InterierInstalacie.tsx\',\n    componentName: \'InterierInstalacie\',\n    title: \'Interi\303\251r a in\305\241tal\303\241cie\',\n    subtitle: \'Technol\303\263gie a pohodlie vo vn\303\272tri.\',\n    eyebrow: \'SPO\304\275AHLIV\303\211 IN\305\240TAL\303\201CIE\',\n    introText: \'Odborn\303\241 realiz\303\241cia vodovodn\303\275ch, elektrick\303\275ch a k\303\272ren\303\241rskych rozvodov a kompletn\303\251 interi\303\251rov\303\251 pr\303\241ce.\',\n    bgImg: \'https://images.unsplash.com/photo-1541888087625-f814d1f27dc0?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'Elektroin\305\241tal\303\241cie a smart dom\303\241cnos\305\245\',\n      \'Vodoin\305\241tal\303\241cie a kanaliz\303\241cia\',\n      \'Podlahov\303\251 vykurovanie a tepeln\303\251 \304\215erpadl\303\241\',\n      \'Sadrokart\303\263nov\303\251 podh\304\276ady a steny\',\n      \'Kompletn\303\251 k\303\272pe\304\276ne na k\304\276\303\272\304\215\'\n    ],\n    carousel: [\n      { title: \'BEZPE\304\214NOS\305\244\', text: \'V\305\241etky in\305\241tal\303\241cie realizujeme pod\304\276a najnov\305\241\303\255ch noriem a s rev\303\255ziou.\', icon: \'ShieldCheck\' },\n      { title: \'MODERN\303\211 TECHNOL\303\223GIE\', text: \'Integrujeme inteligentn\303\251 syst\303\251my pre vy\305\241\305\241\303\255 komfort b\303\275vania.\', icon: \'Sparkles\' },\n      { title: \'PRESNOS\305\244\', text: \'Kladieme d\303\264raz na presnos\305\245 detailov a rovinnos\305\245 povrchov.\', icon: \'Check\' }\n    ],\n    faqs: [\n      { q: \'Dod\303\241vate aj rev\303\255zne spr\303\241vy?\', a: \'\303\201no, ku ka\305\276dej novej elektroin\305\241tal\303\241cii a plynovej pr\303\255pojke dod\303\241vame platn\303\251 rev\303\255zie.\' },\n      { q: \'Rob\303\255te aj podlahov\303\251 k\303\272renie?\', a: \'\303\201no, realizujeme teplovodn\303\251 aj elektrick\303\251 podlahov\303\251 vykurovanie.\' },\n      { q: \'Pracujete aj so sadrokart\303\263nom?\', a: \'Rob\303\255me kompletn\303\251 sadrokart\303\263nov\303\251 syst\303\251my vr\303\241tane sveteln\303\275ch r\303\241mp a podh\304\276adov.\' }\n    ]\n  }\n];\n\nconst renderTemplate = (opts) => {\n  const words = opts.title.split(\' \');\n  const styledTitle = words.map((w, i, a) => {\n    return i === a.length - 1 ? `<span className=\"text-[#E5A93B]\"> ${w}</span>` : w;\n  }).join(\' \');\n\n  return `import { FaqAccordion } from \'../components/FaqAccordion\';\nimport { HardHat, ChevronLeft, ChevronRight, Clock, ShieldCheck, Check, Phone, Sparkles, Facebook, Instagram, MapPin, Mail } from \'lucide-react\';\nimport TopNav from \'../components/TopNav\';\nimport Lightbox from \'../components/Lightbox\';\nimport { Link } from \'react-router-dom\';\nimport { useContactSheet } from \'../context/ContactSheetContext\';\nimport { motion } from \'motion/react\';\nimport { useState, useRef, useEffect } from \'react\';\n\nexport default function ${opts.componentName}() {\n  const galleryImages = [\n    \'https://images.unsplash.com/photo-1589939705384-5185137a7f0f?auto=format&fit=crop&q=80&w=800\',\n    \'https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&q=80&w=800\',\n    \'https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=800\',\n    \'https://images.unsplash.com/photo-1541888087625-f814d1f27dc0?auto=format&fit=crop&q=80&w=800\'\n  ];\n\n  const { openSheet } = useContactSheet();\n  const [lightboxIndex, setLightboxIndex] = useState<number | null>(null);\n  \n  const galleryRef = useRef<HTMLDivElement>(null);\n  const carouselRef = useRef<HTMLDivElement>(null);\n  const [activeGalleryIndex, setActiveGalleryIndex] = useState(0);\n  const [activeFeatureIndex, setActiveFeatureIndex] = useState(0);\n  \n  const scrollGallery = (direction: \'left\' | \'right\') => {\n    if (galleryRef.current) {\n      const scrollAmount = direction === \'left\' ? -300 : 300;\n      galleryRef.current.scrollBy({ left: scrollAmount, behavior: \'smooth\' });\n    }\n  };\n\n  const handleGalleryScroll = () => {\n    if (galleryRef.current) {\n      const scrollPosition = galleryRef.current.scrollLeft;\n      const itemWidth = 300 + 16;\n      const newIndex = Math.round(scrollPosition / itemWidth);\n      setActiveGalleryIndex(newIndex);\n    }\n  };\n\n  const scrollCarousel = (direction: \'left\' | \'right\') => {\n    if (carouselRef.current) {\n      const scrollAmount = direction === \'left\' ? -300 : 300;\n      carouselRef.current.scrollBy({ left: scrollAmount, behavior: \'smooth\' });\n    }\n  };\n\n  const handleCarouselScroll = () => {\n    if (carouselRef.current) {\n      const scrollPosition = carouselRef.current.scrollLeft;\n      const itemWidth = carouselRef.current.offsetWidth * 0.85 + 16;\n      const newIndex = Math.round(scrollPosition / itemWidth);\n      setActiveFeatureIndex(Math.min(newIndex, 2));\n    }\n  };\n\n  useEffect(() => {\n    window.scrollTo(0, 0);\n  }, []);\n\n  const icons = {\n    HardHat: <HardHat className=\"w-5 h-5 text-[#E5A93B]\" />,\n    ShieldCheck: <ShieldCheck className=\"w-5 h-5 text-[#E5A93B]\" />,\n    Check: <Check className=\"w-5 h-5 text-[#E5A93B]\" />,\n    Sparkles: <Sparkles className=\"w-5 h-5 text-[#E5A93B]\" />,\n    Clock: <Clock className=\"w-5 h-5 text-[#E5A93B]\" />\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#F5F5F5] font-sans antialiased selection:bg-[#E5A93B] selection:text-white pb-20 sm:pb-0\">\n      <div className=\"max-w-[480px] mx-auto bg-white min-h-screen relative shadow-2xl flex flex-col\">\n        <TopNav />\n        \n        {/* Hero Section */}\n        <section className=\"relative h-[65dvh] min-h-[450px] shrink-0 flex flex-col justify-end pb-12\">\n          <div className=\"absolute inset-0 z-0\">\n            <img \n              src=\"${opts.bgImg}\" \n              alt=\"${opts.title}\" \n              className=\"w-full h-full object-cover object-center\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/20\"></div>\n          </div>\n          \n          <div className=\"relative z-10 px-6 pt-20\">\n            <h1 \n              className=\"text-[42px] font-extrabold text-white leading-[1.05] tracking-tight mb-4 drop-shadow-sm\" \n              dangerouslySetInnerHTML={{ __html: \\`${styledTitle}\\` }} \n            />\n            <p className=\"text-[16px] text-gray-200 font-medium leading-[1.5] max-w-[280px] drop-shadow-sm\">\n              ${opts.subtitle}\n            </p>\n          </div>\n          \n          <div className=\"absolute -bottom-[2px] left-0 w-full z-20 pointer-events-none\">\n            <svg viewBox=\"0 0 1440 120\" className=\"w-full h-auto text-[#F5F5F5] fill-current preserve-3d\" preserveAspectRatio=\"none\">\n              <path d=\"M0,120 C320,120 420,0 720,0 C1020,0 1120,120 1440,120 L1440,120 L0,120 Z\"></path>\n            </svg>\n          </div>\n        </section>\n\n        {/* 1. SEO / Intro Paragraph */}\n        <section className=\"pt-12 pb-6 px-6 bg-[#F5F5F5]\">\n          <div className=\"relative flex flex-col items-center text-center\">\n            <div className=\"flex flex-col items-center mb-6 relative z-10\">\n              <span className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\n                ${opts.eyebrow}\n              </span>\n              <div className=\"w-8 h-[1px] bg-[#E5A93B]/30 mt-4\"></div>\n            </div>\n            \n            <div className=\"flex flex-col items-center text-center w-full max-w-[340px] relative z-10\">\n              <p className=\"text-[15px] text-gray-700 font-medium leading-[1.6] mb-8\">\n                ${opts.introText}\n              </p>\n              \n              <ul className=\"flex flex-col items-center gap-4 w-full\">\n                <li className=\"flex items-center justify-center gap-3 w-full\">\n                  <HardHat className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Sk\303\272sen\303\255 profesion\303\241li</span>\n                </li>\n                <li className=\"flex items-center justify-center gap-3 w-full\">\n                  <ShieldCheck className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Kvalitn\303\251 materi\303\241ly</span>\n                </li>\n                <li className=\"flex items-center justify-center gap-3 w-full\">\n                  <Check className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Spokojnos\305\245 z\303\241kazn\303\255kov</span>\n                </li>\n              </ul>\n            </div>\n            \n            <div className=\"absolute -left-3 top-20 text-[#E8E6DB] opacity-60 pointer-events-none\">\n               <HardHat className=\"w-16 h-16 -rotate-12\" />\n            </div>\n          </div>\n        </section>\n\n        {/* 2. \304\214O JE S\303\232\304\214AS\305\244OU SLU\305\275BY */}\n        <section className=\"py-8 px-6 bg-[#F5F5F5]\">\n          <div className=\"bg-[#FAF9F5] rounded-[1.5rem] p-6 shadow-sm border border-black/5 flex flex-col gap-6\">\n            <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase text-center\">\n              \304\214O JE S\303\232\304\214AS\305\244OU SLU\305\275BY\n            </h2>\n            \n            <div className=\"flex flex-col gap-5\">\n              ${opts.included.map(item => `\n              <div className=\"flex items-center gap-4 border-b border-gray-200 pb-4 last:border-0 last:pb-0\">\n                <div className=\"w-6 h-6 rounded-full bg-[#E5A93B] flex items-center justify-center shrink-0\">\n                  <Check className=\"w-4 h-4 text-white\" strokeWidth={2} />\n                </div>\n                <span className=\"text-[13px] font-medium text-[#1A1A1A]\">${item}</span>\n              </div>`).join(\'\')}\n            </div>\n          </div>\n        </section>\n\n        {/* 3. UK\303\201\305\275KY NA\305\240EJ PR\303\201CE */}\n        <section className=\"py-8 bg-[#F5F5F5]\">\n          <div className=\"flex items-center justify-between w-full mb-6 px-6\">\n            <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\n              UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\n            </h2>\n            <div className=\"flex gap-2\">\n              <button onClick={() => scrollGallery(\'left\')} className=\"w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center text-[#E5A93B] hover:bg-[#E5A93B]/5 transition-colors\">\n                <ChevronLeft className=\"w-4 h-4\" />\n              </button>\n              <button onClick={() => scrollGallery(\'right\')} className=\"w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center text-[#E5A93B] hover:bg-[#E5A93B]/5 transition-colors\">\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n          \n          <div \n            ref={galleryRef} \n            onScroll={handleGalleryScroll} \n            className=\"flex overflow-x-auto snap-x snap-mandatory gap-4 w-full pb-4 px-6 [&::-webkit-scrollbar]:hidden\" \n            style={{ scrollbarWidth: \'none\', msOverflowStyle: \'none\' }}\n          >\n            {galleryImages.map((src, idx) => (\n              <div key={idx} className=\"shrink-0\">\n                <img \n                  src={src} \n                  alt=\"Uk\303\241\305\276ka pr\303\241ce\" \n                  className=\"w-[300px] h-[225px] object-cover rounded-[1.5rem] shadow-[0_4px_20px_rgba(0,0,0,0.08)] snap-center cursor-pointer hover:opacity-90 transition-opacity\" \n                  onClick={() => setLightboxIndex(idx)} \n                />\n              </div>\n            ))}\n          </div>\n        </section>\n\n        {/* 4. PRE\304\214O T\303\201TO SLU\305\275BA? (Carousel) */}\n        <motion.section \n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true, margin: \"-50px\" }}\n          transition={{ duration: 0.5 }}\n          className=\"py-10 bg-[#F5F5F5] flex flex-col items-start overflow-hidden border-t border-[#E5A93B]/10\"\n        >\n          <div className=\"flex items-center justify-between w-full mb-6 px-6\">\n            <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\n              PRE\304\214O T\303\201TO SLU\305\275BA?\n            </h2>\n            <div className=\"flex gap-2\">\n              <button onClick={() => scrollCarousel(\'left\')} disabled={activeFeatureIndex === 0} className={\\`w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center transition-colors \\${activeFeatureIndex === 0 ? \'opacity-30 cursor-not-allowed text-gray-400\' : \'text-[#E5A93B] hover:bg-[#E5A93B]/5\'}\\`}>\n                <ChevronLeft className=\"w-4 h-4\" />\n              </button>\n              <button onClick={() => scrollCarousel(\'right\')} disabled={activeFeatureIndex === 2} className={\\`w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center transition-colors \\${activeFeatureIndex === 2 ? \'opacity-30 cursor-not-allowed text-gray-400\' : \'text-[#E5A93B] hover:bg-[#E5A93B]/5\'}\\`}>\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n          \n          <div \n            ref={carouselRef} \n            onScroll={handleCarouselScroll}\n            className=\"flex overflow-x-auto snap-x snap-mandatory gap-4 w-full pb-6 px-6 [&::-webkit-scrollbar]:hidden\" \n            style={{ scrollbarWidth: \'none\', msOverflowStyle: \'none\' }}\n          >\n            ${opts.carousel.map((feature, i) => `\n            <div className=\"min-w-[85%] sm:min-w-[280px] snap-center flex flex-col bg-white rounded-[1.5rem] p-7 shadow-[0_4px_20px_rgba(0,0,0,0.03)] border border-black/5 items-start text-left relative\">\n              <div className=\"w-12 h-12 rounded-full bg-[#F5F5F5] flex items-center justify-center mb-5\">\n                {icons[\'${feature.icon}\']}\n              </div>\n              <h3 className=\"text-[14px] font-extrabold text-[#1A1A1A] mb-3 uppercase tracking-wide\">${feature.title}</h3>\n              <p className=\"text-[14px] text-gray-600 font-medium leading-relaxed pr-6\">\n                ${feature.text}\n              </p>\n              <span className=\"absolute bottom-7 right-7 text-[11px] font-bold text-gray-300\">${i + 1} / 3</span>\n            </div>`).join(\'\')}\n          </div>\n        </motion.section>\n\n        {/* 5. \304\214AST\303\211 OT\303\201ZKY */}\n        <section className=\"py-8 px-6 bg-[#F5F5F5] border-t border-[#E5A93B]/10\">\n          <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase mb-6 text-center\">\n            \304\214AST\303\211 OT\303\201ZKY\n          </h2>\n          <div className=\"flex flex-col gap-4\">\n            ${opts.faqs.map(faq => `\n            <FaqAccordion question=\"${faq.q}\" answer=\"${faq.a}\" />`).join(\'\')}\n          </div>\n        </section>\n\n        {/* 6. CTA Banner */}\n        <section className=\"px-6 pt-8 pb-12 bg-[#F5F5F5]\">\n          <div className=\"bg-white rounded-[1.5rem] p-6 flex flex-col items-center text-center shadow-md border border-[#E5A93B]/20\">\n            <div className=\"w-12 h-12 rounded-full bg-[#1A1A1A] flex items-center justify-center mb-4 shadow-md\">\n              <HardHat className=\"w-6 h-6 text-transparent fill-[#E5A93B]\" />\n            </div>\n            \n            <h3 className=\"text-[18px] font-extrabold text-[#1A1A1A] mb-2 leading-tight\">\n              M\303\241te projekt? <br /> Porozpr\303\241vajme sa o \305\210om.\n            </h3>\n            \n            <p className=\"text-[13px] text-gray-600 font-medium mb-6\">\n              Priprav\303\255me v\303\241m nez\303\241v\303\244zn\303\272 cenov\303\272 ponuku a navrhneme najlep\305\241ie rie\305\241enie pre va\305\241e b\303\275vanie.\n            </p>\n            \n            <button \n              onClick={openSheet}\n              className=\"w-full bg-[#E5A93B] hover:bg-[#111111] transition-colors text-white font-bold py-3.5 px-6 rounded-xl flex items-center justify-center gap-3 mb-4 shadow-md\"\n            >\n              <HardHat className=\"w-5 h-5 text-white\" strokeWidth={1.5} />\n              <span className=\"text-[13px] tracking-wider uppercase\">Z\303\215SKA\305\244 PONUKU</span>\n            </button>\n            \n            <a href=\"tel:+421907673697\" className=\"flex items-center gap-3 text-[#E5A93B] font-bold text-[15px] hover:text-[#1A1A1A] transition-colors\">\n              <Phone className=\"w-5 h-5\" strokeWidth={1.5} />\n              0907 673 697\n            </a>\n          </div>\n        </section>\n\n        {/* Footer */}\n        <footer className=\"bg-[#111111] pt-16 pb-8 px-6 text-white relative rounded-t-[2.5rem]\">\n          <div className=\"flex flex-col gap-8 mb-12\">\n            <div>\n              <h3 className=\"text-2xl font-extrabold flex items-center gap-3 mb-4\">\n                <HardHat className=\"w-6 h-6 text-[#E5A93B]\" strokeWidth={1.5} />\n                DESMO STAV, spol. s r.o.\n              </h3>\n              <p className=\"text-gray-400 text-[13px] font-medium leading-relaxed max-w-[250px]\">\n                Profesion\303\241lne stavebn\303\251 slu\305\276by a rekon\305\241trukcie pre va\305\241e lep\305\241ie b\303\275vanie.\n              </p>\n            </div>\n            \n            <div className=\"flex flex-col gap-4\">\n              <a href=\"tel:+421907673697\" className=\"flex items-center gap-3 text-[14px] font-medium text-white hover:text-[#E5A93B] transition-colors\">\n                <Phone className=\"w-5 h-5 text-[#E5A93B]\" strokeWidth={1.5} />\n                +421 907 673 697\n              </a>\n              <a href=\"mailto:info@desmostav.sk\" className=\"flex items-center gap-3 text-[14px] font-medium text-white hover:text-[#E5A93B] transition-colors\">\n                <Mail className=\"w-5 h-5 text-[#E5A93B]\" strokeWidth={1.5} />\n                info@desmostav.sk\n              </a>\n              <div className=\"flex items-start gap-3 text-[14px] font-medium text-white mt-2\">\n                <MapPin className=\"w-5 h-5 text-[#E5A93B] shrink-0\" strokeWidth={1.5} />\n                <span className=\"leading-relaxed\">P\303\264sob\303\255me v<br/>Bratislavskom a Trnavskom kraji</span>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-4 pt-4\">\n              <a href=\"#\" className=\"w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#E5A93B] transition-colors\">\n                <Facebook className=\"w-5 h-5 text-white\" strokeWidth={1.5} />\n              </a>\n              <a href=\"#\" className=\"w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#E5A93B] transition-colors\">\n                <Instagram className=\"w-5 h-5 text-white\" strokeWidth={1.5} />\n              </a>\n            </div>\n          </div>\n          \n          <div className=\"border-t border-white/10 pt-8 flex flex-col items-center text-center\">\n            <p className=\"text-[11px] text-gray-500 font-medium mb-4\">\n              \302\251 {new Date().getFullYear()} DESMO STAV, spol. s r.o. V\305\241etky pr\303\241va vyhraden\303\251.\n            </p>\n            <div className=\"flex gap-4\">\n              <a href=\"#\" className=\"text-[11px] text-gray-500 hover:text-white transition-colors\">Ochrana s\303\272kromia</a>\n              <a href=\"#\" className=\"text-[11px] text-gray-500 hover:text-white transition-colors\">Obchodn\303\251 podmienky</a>\n            </div>\n          </div>\n        </footer>\n      </div>\n      <Lightbox isOpen={lightboxIndex !== null} images={galleryImages} currentIndex={lightboxIndex ?? 0} onNavigate={setLightboxIndex} onClose={() => setLightboxIndex(null)} />\n    </div>\n  );\n}`;\n}\n\nfor (const s of services) {\n  fs.writeFileSync(s.file, renderTemplate(s));\n}\n\nconsole.log(\'Regenerated all service pages with ordered structure.\');\nEOF\nnode generate_services.cjs"
    proposed_command_line: "cat << \'EOF\' > generate_services.cjs\nconst fs = require(\'fs\');\nconst path = require(\'path\');\n\nconst services = [\n  {\n    file: \'src/pages/StavbyNaKluc.tsx\',\n    componentName: \'StavbyNaKluc\',\n    title: \'Stavby na k\304\276\303\272\304\215\',\n    subtitle: \'Od z\303\241kladov a\305\276 po odovzdanie k\304\276\303\272\304\215ov.\',\n    eyebrow: \'BEZSTAROSTN\303\201 V\303\235STAVBA\',\n    introText: \'Postar\303\241me sa o kompletn\303\272 realiz\303\241ciu od v\303\275kopov a\305\276 po fin\303\241lne odovzdanie k\304\276\303\272\304\215ov. S nami m\303\241te istotu dodr\305\276ania term\303\255nov a rozpo\304\215tu.\',\n    bgImg: \'https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'V\303\275kopov\303\251 a z\303\241kladov\303\251 pr\303\241ce\',\n      \'Hrub\303\241 stavba a murovanie\',\n      \'Stre\305\241n\303\251 kon\305\241trukcie a krytiny\',\n      \'Rozvody, in\305\241tal\303\241cie a omietky\',\n      \'Fin\303\241lne povrchov\303\251 \303\272pravy\'\n    ],\n    carousel: [\n      { title: \'KOMPLETN\303\235 SERVIS\', text: \'Od n\303\241vrhu a\305\276 po realiz\303\241ciu zastre\305\241\303\255me v\305\241etko my.\', icon: \'HardHat\' },\n      { title: \'KVALITN\303\211 MATERI\303\201LY\', text: \'Pou\305\276\303\255vame len overen\303\251 a certifikovan\303\251 stavebn\303\251 materi\303\241ly.\', icon: \'ShieldCheck\' },\n      { title: \'Z\303\201RUKA NA DIELO\', text: \'Na na\305\241e stavby poskytujeme pln\303\272 garanciu a z\303\241ru\304\215n\303\275 servis.\', icon: \'Check\' }\n    ],\n    faqs: [\n      { q: \'Ako dlho trv\303\241 stavba domu na k\304\276\303\272\304\215?\', a: \'Od z\303\255skania povolen\303\255 zvy\304\215ajne 8 a\305\276 12 mesiacov v z\303\241vislosti od n\303\241ro\304\215nosti.\' },\n      { q: \'Vybavujete aj stavebn\303\251 povolenie?\', a: \'\303\201no, v r\303\241mci kompletnej slu\305\276by vieme zabezpe\304\215i\305\245 aj in\305\276iniering a povolenia.\' },\n      { q: \'M\303\264\305\276em po\304\215as stavby meni\305\245 materi\303\241ly?\', a: \'Ur\304\215it\303\251 zmeny s\303\272 mo\305\276n\303\251 po vz\303\241jomnej konzult\303\241cii a \303\272prave rozpo\304\215tu.\' },\n      { q: \'Ak\303\251 materi\303\241ly pou\305\276\303\255vate naj\304\215astej\305\241ie?\', a: \'Pracujeme s tehlou, p\303\263robet\303\263nom a preferujeme certifikovan\303\251 zatep\304\276ovacie syst\303\251my.\' }\n    ]\n  },\n  {\n    file: \'src/pages/Rekonstrukcie.tsx\',\n    componentName: \'Rekonstrukcie\',\n    title: \'Rekon\305\241trukcie\',\n    subtitle: \'Nov\303\275 dych pre v\303\241\305\241 star\305\241\303\255 domov.\',\n    eyebrow: \'NOV\303\235 \305\275IVOT PRE V\303\201\305\240 DOMOV\',\n    introText: \'Kompletn\303\251 a \304\215iasto\304\215n\303\251 rekon\305\241trukcie domov a bytov s d\303\264razom na detaily a zachovanie charakteru stavby.\',\n    bgImg: \'https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'B\303\272racie a demola\304\215n\303\251 pr\303\241ce\',\n      \'\303\232prava dispoz\303\255cie a prie\304\215ok\',\n      \'V\303\275mena elektrick\303\275ch a vodovodn\303\275ch rozvodov\',\n      \'Stierkovanie, ma\304\276ovanie a obklady\',\n      \'Pokl\303\241dka podl\303\241h a dver\303\255\'\n    ],\n    carousel: [\n      { title: \'ODBORN\303\211 PORADENSTVO\', text: \'Navrhneme najlep\305\241ie rie\305\241enie pre va\305\241u rekon\305\241trukciu.\', icon: \'HardHat\' },\n      { title: \'MODERNIZ\303\201CIA\', text: \'Zv\303\275\305\241ime energetick\303\272 efektivitu a hodnotu va\305\241ej nehnute\304\276nosti.\', icon: \'Sparkles\' },\n      { title: \'\304\214ISTOTA PRI PR\303\201CI\', text: \'Po\304\215as rekon\305\241trukcie db\303\241me na poriadok a oh\304\276aduplnos\305\245.\', icon: \'Check\' }\n    ],\n    faqs: [\n      { q: \'Zabezpe\304\215ujete aj odvoz stavebn\303\251ho odpadu?\', a: \'\303\201no, kompletn\303\275 odvoz a likvid\303\241cia sutiny je s\303\272\304\215as\305\245ou na\305\241ich slu\305\276ieb.\' },\n      { q: \'Ako dlho trv\303\241 rekon\305\241trukcia bytov\303\251ho jadra?\', a: \'V\303\244\304\215\305\241inou 10 a\305\276 14 pracovn\303\275ch dn\303\255 pod\304\276a zlo\305\276itosti pr\303\241c.\' },\n      { q: \'Potrebujem na rekon\305\241trukciu povolenie?\', a: \'Pri z\303\241sahu do nosn\303\275ch kon\305\241trukci\303\255 \303\241no, pri be\305\276n\303\275ch \303\272prav\303\241ch sta\304\215\303\255 ohl\303\241\305\241ka.\' }\n    ]\n  },\n  {\n    file: \'src/pages/ExterierFasady.tsx\',\n    componentName: \'ExterierFasady\',\n    title: \'Exteri\303\251r a fas\303\241dy\',\n    subtitle: \'Kr\303\241sna a funk\304\215n\303\241 tv\303\241r v\303\241\305\241ho domu.\',\n    eyebrow: \'DOKONAL\303\201 VIZITKA DOMU\',\n    introText: \'Zabezpe\304\215\303\255me zateplenie, nov\303\251 fas\303\241dy a \303\272pravu exteri\303\251ru pre lep\305\241iu ochranu a vzh\304\276ad va\305\241ej nehnute\304\276nosti.\',\n    bgImg: \'https://images.unsplash.com/photo-1589939705384-5185137a7f0f?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'Zatep\304\276ovanie fas\303\241d (EPS, miner\303\241lna vlna)\',\n      \'Aplik\303\241cia u\305\241\304\276achtil\303\275ch omietok\',\n      \'Fas\303\241dne obklady a dekorat\303\255vne prvky\',\n      \'V\303\275stavba plotov a oporn\303\275ch m\303\272rov\',\n      \'Z\303\241mkov\303\251 dla\305\276by a terasy\'\n    ],\n    carousel: [\n      { title: \'\303\232SPORA ENERGI\303\215\', text: \'Kvalitn\303\251 zateplenie v\303\275razne zn\303\255\305\276i va\305\241e n\303\241klady na vykurovanie.\', icon: \'ShieldCheck\' },\n      { title: \'OCHRANA STAVBY\', text: \'Fas\303\241da chr\303\241ni dom pred poveternostn\303\275mi vplyvmi a vlhkos\305\245ou.\', icon: \'HardHat\' },\n      { title: \'ESTETICK\303\235 VZH\304\275AD\', text: \'Modern\303\251 materi\303\241ly dodaj\303\272 v\303\241\305\241mu domu exkluz\303\255vny charakter.\', icon: \'Sparkles\' }\n    ],\n    faqs: [\n      { q: \'Kedy je najlep\305\241\303\255 \304\215as na zatep\304\276ovanie?\', a: \'Ide\303\241lne s\303\272 jarn\303\251 a jesenn\303\251 mesiace, ke\304\217 teploty neklesaj\303\272 pod 5\302\260C a nie s\303\272 hor\303\272\304\215avy.\' },\n      { q: \'Ak\303\275 izolant je najlep\305\241\303\255?\', a: \'Z\303\241le\305\276\303\255 na type muriva, naj\304\215astej\305\241ie pou\305\276\303\255vame polystyr\303\251n alebo miner\303\241lnu vlnu pre lep\305\241iu priedu\305\241nos\305\245.\' },\n      { q: \'Poskytujete aj vizualiz\303\241cie fas\303\241d?\', a: \'Pri rozsiahlej\305\241\303\255ch realiz\303\241ci\303\241ch vieme zabezpe\304\215i\305\245 farebn\303\275 n\303\241vrh.\' }\n    ]\n  },\n  {\n    file: \'src/pages/InterierInstalacie.tsx\',\n    componentName: \'InterierInstalacie\',\n    title: \'Interi\303\251r a in\305\241tal\303\241cie\',\n    subtitle: \'Technol\303\263gie a pohodlie vo vn\303\272tri.\',\n    eyebrow: \'SPO\304\275AHLIV\303\211 IN\305\240TAL\303\201CIE\',\n    introText: \'Odborn\303\241 realiz\303\241cia vodovodn\303\275ch, elektrick\303\275ch a k\303\272ren\303\241rskych rozvodov a kompletn\303\251 interi\303\251rov\303\251 pr\303\241ce.\',\n    bgImg: \'https://images.unsplash.com/photo-1541888087625-f814d1f27dc0?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'Elektroin\305\241tal\303\241cie a smart dom\303\241cnos\305\245\',\n      \'Vodoin\305\241tal\303\241cie a kanaliz\303\241cia\',\n      \'Podlahov\303\251 vykurovanie a tepeln\303\251 \304\215erpadl\303\241\',\n      \'Sadrokart\303\263nov\303\251 podh\304\276ady a steny\',\n      \'Kompletn\303\251 k\303\272pe\304\276ne na k\304\276\303\272\304\215\'\n    ],\n    carousel: [\n      { title: \'BEZPE\304\214NOS\305\244\', text: \'V\305\241etky in\305\241tal\303\241cie realizujeme pod\304\276a najnov\305\241\303\255ch noriem a s rev\303\255ziou.\', icon: \'ShieldCheck\' },\n      { title: \'MODERN\303\211 TECHNOL\303\223GIE\', text: \'Integrujeme inteligentn\303\251 syst\303\251my pre vy\305\241\305\241\303\255 komfort b\303\275vania.\', icon: \'Sparkles\' },\n      { title: \'PRESNOS\305\244\', text: \'Kladieme d\303\264raz na presnos\305\245 detailov a rovinnos\305\245 povrchov.\', icon: \'Check\' }\n    ],\n    faqs: [\n      { q: \'Dod\303\241vate aj rev\303\255zne spr\303\241vy?\', a: \'\303\201no, ku ka\305\276dej novej elektroin\305\241tal\303\241cii a plynovej pr\303\255pojke dod\303\241vame platn\303\251 rev\303\255zie.\' },\n      { q: \'Rob\303\255te aj podlahov\303\251 k\303\272renie?\', a: \'\303\201no, realizujeme teplovodn\303\251 aj elektrick\303\251 podlahov\303\251 vykurovanie.\' },\n      { q: \'Pracujete aj so sadrokart\303\263nom?\', a: \'Rob\303\255me kompletn\303\251 sadrokart\303\263nov\303\251 syst\303\251my vr\303\241tane sveteln\303\275ch r\303\241mp a podh\304\276adov.\' }\n    ]\n  }\n];\n\nconst renderTemplate = (opts) => {\n  const words = opts.title.split(\' \');\n  const styledTitle = words.map((w, i, a) => {\n    return i === a.length - 1 ? `<span className=\"text-[#E5A93B]\"> ${w}</span>` : w;\n  }).join(\' \');\n\n  return `import { FaqAccordion } from \'../components/FaqAccordion\';\nimport { HardHat, ChevronLeft, ChevronRight, Clock, ShieldCheck, Check, Phone, Sparkles, Facebook, Instagram, MapPin, Mail } from \'lucide-react\';\nimport TopNav from \'../components/TopNav\';\nimport Lightbox from \'../components/Lightbox\';\nimport { Link } from \'react-router-dom\';\nimport { useContactSheet } from \'../context/ContactSheetContext\';\nimport { motion } from \'motion/react\';\nimport { useState, useRef, useEffect } from \'react\';\n\nexport default function ${opts.componentName}() {\n  const galleryImages = [\n    \'https://images.unsplash.com/photo-1589939705384-5185137a7f0f?auto=format&fit=crop&q=80&w=800\',\n    \'https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&q=80&w=800\',\n    \'https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=800\',\n    \'https://images.unsplash.com/photo-1541888087625-f814d1f27dc0?auto=format&fit=crop&q=80&w=800\'\n  ];\n\n  const { openSheet } = useContactSheet();\n  const [lightboxIndex, setLightboxIndex] = useState<number | null>(null);\n  \n  const galleryRef = useRef<HTMLDivElement>(null);\n  const carouselRef = useRef<HTMLDivElement>(null);\n  const [activeGalleryIndex, setActiveGalleryIndex] = useState(0);\n  const [activeFeatureIndex, setActiveFeatureIndex] = useState(0);\n  \n  const scrollGallery = (direction: \'left\' | \'right\') => {\n    if (galleryRef.current) {\n      const scrollAmount = direction === \'left\' ? -300 : 300;\n      galleryRef.current.scrollBy({ left: scrollAmount, behavior: \'smooth\' });\n    }\n  };\n\n  const handleGalleryScroll = () => {\n    if (galleryRef.current) {\n      const scrollPosition = galleryRef.current.scrollLeft;\n      const itemWidth = 300 + 16;\n      const newIndex = Math.round(scrollPosition / itemWidth);\n      setActiveGalleryIndex(newIndex);\n    }\n  };\n\n  const scrollCarousel = (direction: \'left\' | \'right\') => {\n    if (carouselRef.current) {\n      const scrollAmount = direction === \'left\' ? -300 : 300;\n      carouselRef.current.scrollBy({ left: scrollAmount, behavior: \'smooth\' });\n    }\n  };\n\n  const handleCarouselScroll = () => {\n    if (carouselRef.current) {\n      const scrollPosition = carouselRef.current.scrollLeft;\n      const itemWidth = carouselRef.current.offsetWidth * 0.85 + 16;\n      const newIndex = Math.round(scrollPosition / itemWidth);\n      setActiveFeatureIndex(Math.min(newIndex, 2));\n    }\n  };\n\n  useEffect(() => {\n    window.scrollTo(0, 0);\n  }, []);\n\n  const icons = {\n    HardHat: <HardHat className=\"w-5 h-5 text-[#E5A93B]\" />,\n    ShieldCheck: <ShieldCheck className=\"w-5 h-5 text-[#E5A93B]\" />,\n    Check: <Check className=\"w-5 h-5 text-[#E5A93B]\" />,\n    Sparkles: <Sparkles className=\"w-5 h-5 text-[#E5A93B]\" />,\n    Clock: <Clock className=\"w-5 h-5 text-[#E5A93B]\" />\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#F5F5F5] font-sans antialiased selection:bg-[#E5A93B] selection:text-white pb-20 sm:pb-0\">\n      <div className=\"max-w-[480px] mx-auto bg-white min-h-screen relative shadow-2xl flex flex-col\">\n        <TopNav />\n        \n        {/* Hero Section */}\n        <section className=\"relative h-[65dvh] min-h-[450px] shrink-0 flex flex-col justify-end pb-12\">\n          <div className=\"absolute inset-0 z-0\">\n            <img \n              src=\"${opts.bgImg}\" \n              alt=\"${opts.title}\" \n              className=\"w-full h-full object-cover object-center\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/20\"></div>\n          </div>\n          \n          <div className=\"relative z-10 px-6 pt-20\">\n            <h1 \n              className=\"text-[42px] font-extrabold text-white leading-[1.05] tracking-tight mb-4 drop-shadow-sm\" \n              dangerouslySetInnerHTML={{ __html: \\`${styledTitle}\\` }} \n            />\n            <p className=\"text-[16px] text-gray-200 font-medium leading-[1.5] max-w-[280px] drop-shadow-sm\">\n              ${opts.subtitle}\n            </p>\n          </div>\n          \n          <div className=\"absolute -bottom-[2px] left-0 w-full z-20 pointer-events-none\">\n            <svg viewBox=\"0 0 1440 120\" className=\"w-full h-auto text-[#F5F5F5] fill-current preserve-3d\" preserveAspectRatio=\"none\">\n              <path d=\"M0,120 C320,120 420,0 720,0 C1020,0 1120,120 1440,120 L1440,120 L0,120 Z\"></path>\n            </svg>\n          </div>\n        </section>\n\n        {/* 1. SEO / Intro Paragraph */}\n        <section className=\"pt-12 pb-6 px-6 bg-[#F5F5F5]\">\n          <div className=\"relative flex flex-col items-center text-center\">\n            <div className=\"flex flex-col items-center mb-6 relative z-10\">\n              <span className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\n                ${opts.eyebrow}\n              </span>\n              <div className=\"w-8 h-[1px] bg-[#E5A93B]/30 mt-4\"></div>\n            </div>\n            \n            <div className=\"flex flex-col items-center text-center w-full max-w-[340px] relative z-10\">\n              <p className=\"text-[15px] text-gray-700 font-medium leading-[1.6] mb-8\">\n                ${opts.introText}\n              </p>\n              \n              <ul className=\"flex flex-col items-center gap-4 w-full\">\n                <li className=\"flex items-center justify-center gap-3 w-full\">\n                  <HardHat className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Sk\303\272sen\303\255 profesion\303\241li</span>\n                </li>\n                <li className=\"flex items-center justify-center gap-3 w-full\">\n                  <ShieldCheck className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Kvalitn\303\251 materi\303\241ly</span>\n                </li>\n                <li className=\"flex items-center justify-center gap-3 w-full\">\n                  <Check className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Spokojnos\305\245 z\303\241kazn\303\255kov</span>\n                </li>\n              </ul>\n            </div>\n            \n            <div className=\"absolute -left-3 top-20 text-[#E8E6DB] opacity-60 pointer-events-none\">\n               <HardHat className=\"w-16 h-16 -rotate-12\" />\n            </div>\n          </div>\n        </section>\n\n        {/* 2. \304\214O JE S\303\232\304\214AS\305\244OU SLU\305\275BY */}\n        <section className=\"py-8 px-6 bg-[#F5F5F5]\">\n          <div className=\"bg-[#FAF9F5] rounded-[1.5rem] p-6 shadow-sm border border-black/5 flex flex-col gap-6\">\n            <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase text-center\">\n              \304\214O JE S\303\232\304\214AS\305\244OU SLU\305\275BY\n            </h2>\n            \n            <div className=\"flex flex-col gap-5\">\n              ${opts.included.map(item => `\n              <div className=\"flex items-center gap-4 border-b border-gray-200 pb-4 last:border-0 last:pb-0\">\n                <div className=\"w-6 h-6 rounded-full bg-[#E5A93B] flex items-center justify-center shrink-0\">\n                  <Check className=\"w-4 h-4 text-white\" strokeWidth={2} />\n                </div>\n                <span className=\"text-[13px] font-medium text-[#1A1A1A]\">${item}</span>\n              </div>`).join(\'\')}\n            </div>\n          </div>\n        </section>\n\n        {/* 3. UK\303\201\305\275KY NA\305\240EJ PR\303\201CE */}\n        <section className=\"py-8 bg-[#F5F5F5]\">\n          <div className=\"flex items-center justify-between w-full mb-6 px-6\">\n            <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\n              UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\n            </h2>\n            <div className=\"flex gap-2\">\n              <button onClick={() => scrollGallery(\'left\')} className=\"w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center text-[#E5A93B] hover:bg-[#E5A93B]/5 transition-colors\">\n                <ChevronLeft className=\"w-4 h-4\" />\n              </button>\n              <button onClick={() => scrollGallery(\'right\')} className=\"w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center text-[#E5A93B] hover:bg-[#E5A93B]/5 transition-colors\">\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n          \n          <div \n            ref={galleryRef} \n            onScroll={handleGalleryScroll} \n            className=\"flex overflow-x-auto snap-x snap-mandatory gap-4 w-full pb-4 px-6 [&::-webkit-scrollbar]:hidden\" \n            style={{ scrollbarWidth: \'none\', msOverflowStyle: \'none\' }}\n          >\n            {galleryImages.map((src, idx) => (\n              <div key={idx} className=\"shrink-0\">\n                <img \n                  src={src} \n                  alt=\"Uk\303\241\305\276ka pr\303\241ce\" \n                  className=\"w-[300px] h-[225px] object-cover rounded-[1.5rem] shadow-[0_4px_20px_rgba(0,0,0,0.08)] snap-center cursor-pointer hover:opacity-90 transition-opacity\" \n                  onClick={() => setLightboxIndex(idx)} \n                />\n              </div>\n            ))}\n          </div>\n        </section>\n\n        {/* 4. PRE\304\214O T\303\201TO SLU\305\275BA? (Carousel) */}\n        <motion.section \n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true, margin: \"-50px\" }}\n          transition={{ duration: 0.5 }}\n          className=\"py-10 bg-[#F5F5F5] flex flex-col items-start overflow-hidden border-t border-[#E5A93B]/10\"\n        >\n          <div className=\"flex items-center justify-between w-full mb-6 px-6\">\n            <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\n              PRE\304\214O T\303\201TO SLU\305\275BA?\n            </h2>\n            <div className=\"flex gap-2\">\n              <button onClick={() => scrollCarousel(\'left\')} disabled={activeFeatureIndex === 0} className={\\`w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center transition-colors \\${activeFeatureIndex === 0 ? \'opacity-30 cursor-not-allowed text-gray-400\' : \'text-[#E5A93B] hover:bg-[#E5A93B]/5\'}\\`}>\n                <ChevronLeft className=\"w-4 h-4\" />\n              </button>\n              <button onClick={() => scrollCarousel(\'right\')} disabled={activeFeatureIndex === 2} className={\\`w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center transition-colors \\${activeFeatureIndex === 2 ? \'opacity-30 cursor-not-allowed text-gray-400\' : \'text-[#E5A93B] hover:bg-[#E5A93B]/5\'}\\`}>\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n          \n          <div \n            ref={carouselRef} \n            onScroll={handleCarouselScroll}\n            className=\"flex overflow-x-auto snap-x snap-mandatory gap-4 w-full pb-6 px-6 [&::-webkit-scrollbar]:hidden\" \n            style={{ scrollbarWidth: \'none\', msOverflowStyle: \'none\' }}\n          >\n            ${opts.carousel.map((feature, i) => `\n            <div className=\"min-w-[85%] sm:min-w-[280px] snap-center flex flex-col bg-white rounded-[1.5rem] p-7 shadow-[0_4px_20px_rgba(0,0,0,0.03)] border border-black/5 items-start text-left relative\">\n              <div className=\"w-12 h-12 rounded-full bg-[#F5F5F5] flex items-center justify-center mb-5\">\n                {icons[\'${feature.icon}\']}\n              </div>\n              <h3 className=\"text-[14px] font-extrabold text-[#1A1A1A] mb-3 uppercase tracking-wide\">${feature.title}</h3>\n              <p className=\"text-[14px] text-gray-600 font-medium leading-relaxed pr-6\">\n                ${feature.text}\n              </p>\n              <span className=\"absolute bottom-7 right-7 text-[11px] font-bold text-gray-300\">${i + 1} / 3</span>\n            </div>`).join(\'\')}\n          </div>\n        </motion.section>\n\n        {/* 5. \304\214AST\303\211 OT\303\201ZKY */}\n        <section className=\"py-8 px-6 bg-[#F5F5F5] border-t border-[#E5A93B]/10\">\n          <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase mb-6 text-center\">\n            \304\214AST\303\211 OT\303\201ZKY\n          </h2>\n          <div className=\"flex flex-col gap-4\">\n            ${opts.faqs.map(faq => `\n            <FaqAccordion question=\"${faq.q}\" answer=\"${faq.a}\" />`).join(\'\')}\n          </div>\n        </section>\n\n        {/* 6. CTA Banner */}\n        <section className=\"px-6 pt-8 pb-12 bg-[#F5F5F5]\">\n          <div className=\"bg-white rounded-[1.5rem] p-6 flex flex-col items-center text-center shadow-md border border-[#E5A93B]/20\">\n            <div className=\"w-12 h-12 rounded-full bg-[#1A1A1A] flex items-center justify-center mb-4 shadow-md\">\n              <HardHat className=\"w-6 h-6 text-transparent fill-[#E5A93B]\" />\n            </div>\n            \n            <h3 className=\"text-[18px] font-extrabold text-[#1A1A1A] mb-2 leading-tight\">\n              M\303\241te projekt? <br /> Porozpr\303\241vajme sa o \305\210om.\n            </h3>\n            \n            <p className=\"text-[13px] text-gray-600 font-medium mb-6\">\n              Priprav\303\255me v\303\241m nez\303\241v\303\244zn\303\272 cenov\303\272 ponuku a navrhneme najlep\305\241ie rie\305\241enie pre va\305\241e b\303\275vanie.\n            </p>\n            \n            <button \n              onClick={openSheet}\n              className=\"w-full bg-[#E5A93B] hover:bg-[#111111] transition-colors text-white font-bold py-3.5 px-6 rounded-xl flex items-center justify-center gap-3 mb-4 shadow-md\"\n            >\n              <HardHat className=\"w-5 h-5 text-white\" strokeWidth={1.5} />\n              <span className=\"text-[13px] tracking-wider uppercase\">Z\303\215SKA\305\244 PONUKU</span>\n            </button>\n            \n            <a href=\"tel:+421907673697\" className=\"flex items-center gap-3 text-[#E5A93B] font-bold text-[15px] hover:text-[#1A1A1A] transition-colors\">\n              <Phone className=\"w-5 h-5\" strokeWidth={1.5} />\n              0907 673 697\n            </a>\n          </div>\n        </section>\n\n        {/* Footer */}\n        <footer className=\"bg-[#111111] pt-16 pb-8 px-6 text-white relative rounded-t-[2.5rem]\">\n          <div className=\"flex flex-col gap-8 mb-12\">\n            <div>\n              <h3 className=\"text-2xl font-extrabold flex items-center gap-3 mb-4\">\n                <HardHat className=\"w-6 h-6 text-[#E5A93B]\" strokeWidth={1.5} />\n                DESMO STAV, spol. s r.o.\n              </h3>\n              <p className=\"text-gray-400 text-[13px] font-medium leading-relaxed max-w-[250px]\">\n                Profesion\303\241lne stavebn\303\251 slu\305\276by a rekon\305\241trukcie pre va\305\241e lep\305\241ie b\303\275vanie.\n              </p>\n            </div>\n            \n            <div className=\"flex flex-col gap-4\">\n              <a href=\"tel:+421907673697\" className=\"flex items-center gap-3 text-[14px] font-medium text-white hover:text-[#E5A93B] transition-colors\">\n                <Phone className=\"w-5 h-5 text-[#E5A93B]\" strokeWidth={1.5} />\n                +421 907 673 697\n              </a>\n              <a href=\"mailto:info@desmostav.sk\" className=\"flex items-center gap-3 text-[14px] font-medium text-white hover:text-[#E5A93B] transition-colors\">\n                <Mail className=\"w-5 h-5 text-[#E5A93B]\" strokeWidth={1.5} />\n                info@desmostav.sk\n              </a>\n              <div className=\"flex items-start gap-3 text-[14px] font-medium text-white mt-2\">\n                <MapPin className=\"w-5 h-5 text-[#E5A93B] shrink-0\" strokeWidth={1.5} />\n                <span className=\"leading-relaxed\">P\303\264sob\303\255me v<br/>Bratislavskom a Trnavskom kraji</span>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-4 pt-4\">\n              <a href=\"#\" className=\"w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#E5A93B] transition-colors\">\n                <Facebook className=\"w-5 h-5 text-white\" strokeWidth={1.5} />\n              </a>\n              <a href=\"#\" className=\"w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#E5A93B] transition-colors\">\n                <Instagram className=\"w-5 h-5 text-white\" strokeWidth={1.5} />\n              </a>\n            </div>\n          </div>\n          \n          <div className=\"border-t border-white/10 pt-8 flex flex-col items-center text-center\">\n            <p className=\"text-[11px] text-gray-500 font-medium mb-4\">\n              \302\251 {new Date().getFullYear()} DESMO STAV, spol. s r.o. V\305\241etky pr\303\241va vyhraden\303\251.\n            </p>\n            <div className=\"flex gap-4\">\n              <a href=\"#\" className=\"text-[11px] text-gray-500 hover:text-white transition-colors\">Ochrana s\303\272kromia</a>\n              <a href=\"#\" className=\"text-[11px] text-gray-500 hover:text-white transition-colors\">Obchodn\303\251 podmienky</a>\n            </div>\n          </div>\n        </footer>\n      </div>\n      <Lightbox isOpen={lightboxIndex !== null} images={galleryImages} currentIndex={lightboxIndex ?? 0} onNavigate={setLightboxIndex} onClose={() => setLightboxIndex(null)} />\n    </div>\n  );\n}`;\n}\n\nfor (const s of services) {\n  fs.writeFileSync(s.file, renderTemplate(s));\n}\n\nconsole.log(\'Regenerated all service pages with ordered structure.\');\nEOF\nnode generate_services.cjs"
    shell_name: "bash"
  }
  task_details {
    id: "9ed6efe4-32a8-4378-9e7b-51ad6c5b2adf/task-247"
    description: "cat << \'EOF\' > generate_services.cjs\nconst fs = require(\'fs\');\nconst path = require(\'path\');\n\nconst services = [\n  {\n    file: \'src/pages/StavbyNaKluc.tsx\',\n    componentName: \'StavbyNaKluc\',\n    title: \'Stavby na k\304\276\303\272\304\215\',\n    subtitle: \'Od z\303\241kladov a\305\276 po odovzdanie k\304\276\303\272\304\215ov.\',\n    eyebrow: \'BEZSTAROSTN\303\201 V\303\235STAVBA\',\n    introText: \'Postar\303\241me sa o kompletn\303\272 realiz\303\241ciu od v\303\275kopov a\305\276 po fin\303\241lne odovzdanie k\304\276\303\272\304\215ov. S nami m\303\241te istotu dodr\305\276ania term\303\255nov a rozpo\304\215tu.\',\n    bgImg: \'https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'V\303\275kopov\303\251 a z\303\241kladov\303\251 pr\303\241ce\',\n      \'Hrub\303\241 stavba a murovanie\',\n      \'Stre\305\241n\303\251 kon\305\241trukcie a krytiny\',\n      \'Rozvody, in\305\241tal\303\241cie a omietky\',\n      \'Fin\303\241lne povrchov\303\251 \303\272pravy\'\n    ],\n    carousel: [\n      { title: \'KOMPLETN\303\235 SERVIS\', text: \'Od n\303\241vrhu a\305\276 po realiz\303\241ciu zastre\305\241\303\255me v\305\241etko my.\', icon: \'HardHat\' },\n      { title: \'KVALITN\303\211 MATERI\303\201LY\', text: \'Pou\305\276\303\255vame len overen\303\251 a certifikovan\303\251 stavebn\303\251 materi\303\241ly.\', icon: \'ShieldCheck\' },\n      { title: \'Z\303\201RUKA NA DIELO\', text: \'Na na\305\241e stavby poskytujeme pln\303\272 garanciu a z\303\241ru\304\215n\303\275 servis.\', icon: \'Check\' }\n    ],\n    faqs: [\n      { q: \'Ako dlho trv\303\241 stavba domu na k\304\276\303\272\304\215?\', a: \'Od z\303\255skania povolen\303\255 zvy\304\215ajne 8 a\305\276 12 mesiacov v z\303\241vislosti od n\303\241ro\304\215nosti.\' },\n      { q: \'Vybavujete aj stavebn\303\251 povolenie?\', a: \'\303\201no, v r\303\241mci kompletnej slu\305\276by vieme zabezpe\304\215i\305\245 aj in\305\276iniering a povolenia.\' },\n      { q: \'M\303\264\305\276em po\304\215as stavby meni\305\245 materi\303\241ly?\', a: \'Ur\304\215it\303\251 zmeny s\303\272 mo\305\276n\303\251 po vz\303\241jomnej konzult\303\241cii a \303\272prave rozpo\304\215tu.\' },\n      { q: \'Ak\303\251 materi\303\241ly pou\305\276\303\255vate naj\304\215astej\305\241ie?\', a: \'Pracujeme s tehlou, p\303\263robet\303\263nom a preferujeme certifikovan\303\251 zatep\304\276ovacie syst\303\251my.\' }\n    ]\n  },\n  {\n    file: \'src/pages/Rekonstrukcie.tsx\',\n    componentName: \'Rekonstrukcie\',\n    title: \'Rekon\305\241trukcie\',\n    subtitle: \'Nov\303\275 dych pre v\303\241\305\241 star\305\241\303\255 domov.\',\n    eyebrow: \'NOV\303\235 \305\275IVOT PRE V\303\201\305\240 DOMOV\',\n    introText: \'Kompletn\303\251 a \304\215iasto\304\215n\303\251 rekon\305\241trukcie domov a bytov s d\303\264razom na detaily a zachovanie charakteru stavby.\',\n    bgImg: \'https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'B\303\272racie a demola\304\215n\303\251 pr\303\241ce\',\n      \'\303\232prava dispoz\303\255cie a prie\304\215ok\',\n      \'V\303\275mena elektrick\303\275ch a vodovodn\303\275ch rozvodov\',\n      \'Stierkovanie, ma\304\276ovanie a obklady\',\n      \'Pokl\303\241dka podl\303\241h a dver\303\255\'\n    ],\n    carousel: [\n      { title: \'ODBORN\303\211 PORADENSTVO\', text: \'Navrhneme najlep\305\241ie rie\305\241enie pre va\305\241u rekon\305\241trukciu.\', icon: \'HardHat\' },\n      { title: \'MODERNIZ\303\201CIA\', text: \'Zv\303\275\305\241ime energetick\303\272 efektivitu a hodnotu va\305\241ej nehnute\304\276nosti.\', icon: \'Sparkles\' },\n      { title: \'\304\214ISTOTA PRI PR\303\201CI\', text: \'Po\304\215as rekon\305\241trukcie db\303\241me na poriadok a oh\304\276aduplnos\305\245.\', icon: \'Check\' }\n    ],\n    faqs: [\n      { q: \'Zabezpe\304\215ujete aj odvoz stavebn\303\251ho odpadu?\', a: \'\303\201no, kompletn\303\275 odvoz a likvid\303\241cia sutiny je s\303\272\304\215as\305\245ou na\305\241ich slu\305\276ieb.\' },\n      { q: \'Ako dlho trv\303\241 rekon\305\241trukcia bytov\303\251ho jadra?\', a: \'V\303\244\304\215\305\241inou 10 a\305\276 14 pracovn\303\275ch dn\303\255 pod\304\276a zlo\305\276itosti pr\303\241c.\' },\n      { q: \'Potrebujem na rekon\305\241trukciu povolenie?\', a: \'Pri z\303\241sahu do nosn\303\275ch kon\305\241trukci\303\255 \303\241no, pri be\305\276n\303\275ch \303\272prav\303\241ch sta\304\215\303\255 ohl\303\241\305\241ka.\' }\n    ]\n  },\n  {\n    file: \'src/pages/ExterierFasady.tsx\',\n    componentName: \'ExterierFasady\',\n    title: \'Exteri\303\251r a fas\303\241dy\',\n    subtitle: \'Kr\303\241sna a funk\304\215n\303\241 tv\303\241r v\303\241\305\241ho domu.\',\n    eyebrow: \'DOKONAL\303\201 VIZITKA DOMU\',\n    introText: \'Zabezpe\304\215\303\255me zateplenie, nov\303\251 fas\303\241dy a \303\272pravu exteri\303\251ru pre lep\305\241iu ochranu a vzh\304\276ad va\305\241ej nehnute\304\276nosti.\',\n    bgImg: \'https://images.unsplash.com/photo-1589939705384-5185137a7f0f?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'Zatep\304\276ovanie fas\303\241d (EPS, miner\303\241lna vlna)\',\n      \'Aplik\303\241cia u\305\241\304\276achtil\303\275ch omietok\',\n      \'Fas\303\241dne obklady a dekorat\303\255vne prvky\',\n      \'V\303\275stavba plotov a oporn\303\275ch m\303\272rov\',\n      \'Z\303\241mkov\303\251 dla\305\276by a terasy\'\n    ],\n    carousel: [\n      { title: \'\303\232SPORA ENERGI\303\215\', text: \'Kvalitn\303\251 zateplenie v\303\275razne zn\303\255\305\276i va\305\241e n\303\241klady na vykurovanie.\', icon: \'ShieldCheck\' },\n      { title: \'OCHRANA STAVBY\', text: \'Fas\303\241da chr\303\241ni dom pred poveternostn\303\275mi vplyvmi a vlhkos\305\245ou.\', icon: \'HardHat\' },\n      { title: \'ESTETICK\303\235 VZH\304\275AD\', text: \'Modern\303\251 materi\303\241ly dodaj\303\272 v\303\241\305\241mu domu exkluz\303\255vny charakter.\', icon: \'Sparkles\' }\n    ],\n    faqs: [\n      { q: \'Kedy je najlep\305\241\303\255 \304\215as na zatep\304\276ovanie?\', a: \'Ide\303\241lne s\303\272 jarn\303\251 a jesenn\303\251 mesiace, ke\304\217 teploty neklesaj\303\272 pod 5\302\260C a nie s\303\272 hor\303\272\304\215avy.\' },\n      { q: \'Ak\303\275 izolant je najlep\305\241\303\255?\', a: \'Z\303\241le\305\276\303\255 na type muriva, naj\304\215astej\305\241ie pou\305\276\303\255vame polystyr\303\251n alebo miner\303\241lnu vlnu pre lep\305\241iu priedu\305\241nos\305\245.\' },\n      { q: \'Poskytujete aj vizualiz\303\241cie fas\303\241d?\', a: \'Pri rozsiahlej\305\241\303\255ch realiz\303\241ci\303\241ch vieme zabezpe\304\215i\305\245 farebn\303\275 n\303\241vrh.\' }\n    ]\n  },\n  {\n    file: \'src/pages/InterierInstalacie.tsx\',\n    componentName: \'InterierInstalacie\',\n    title: \'Interi\303\251r a in\305\241tal\303\241cie\',\n    subtitle: \'Technol\303\263gie a pohodlie vo vn\303\272tri.\',\n    eyebrow: \'SPO\304\275AHLIV\303\211 IN\305\240TAL\303\201CIE\',\n    introText: \'Odborn\303\241 realiz\303\241cia vodovodn\303\275ch, elektrick\303\275ch a k\303\272ren\303\241rskych rozvodov a kompletn\303\251 interi\303\251rov\303\251 pr\303\241ce.\',\n    bgImg: \'https://images.unsplash.com/photo-1541888087625-f814d1f27dc0?auto=format&fit=crop&q=80&w=1200\',\n    included: [\n      \'Elektroin\305\241tal\303\241cie a smart dom\303\241cnos\305\245\',\n      \'Vodoin\305\241tal\303\241cie a kanaliz\303\241cia\',\n      \'Podlahov\303\251 vykurovanie a tepeln\303\251 \304\215erpadl\303\241\',\n      \'Sadrokart\303\263nov\303\251 podh\304\276ady a steny\',\n      \'Kompletn\303\251 k\303\272pe\304\276ne na k\304\276\303\272\304\215\'\n    ],\n    carousel: [\n      { title: \'BEZPE\304\214NOS\305\244\', text: \'V\305\241etky in\305\241tal\303\241cie realizujeme pod\304\276a najnov\305\241\303\255ch noriem a s rev\303\255ziou.\', icon: \'ShieldCheck\' },\n      { title: \'MODERN\303\211 TECHNOL\303\223GIE\', text: \'Integrujeme inteligentn\303\251 syst\303\251my pre vy\305\241\305\241\303\255 komfort b\303\275vania.\', icon: \'Sparkles\' },\n      { title: \'PRESNOS\305\244\', text: \'Kladieme d\303\264raz na presnos\305\245 detailov a rovinnos\305\245 povrchov.\', icon: \'Check\' }\n    ],\n    faqs: [\n      { q: \'Dod\303\241vate aj rev\303\255zne spr\303\241vy?\', a: \'\303\201no, ku ka\305\276dej novej elektroin\305\241tal\303\241cii a plynovej pr\303\255pojke dod\303\241vame platn\303\251 rev\303\255zie.\' },\n      { q: \'Rob\303\255te aj podlahov\303\251 k\303\272renie?\', a: \'\303\201no, realizujeme teplovodn\303\251 aj elektrick\303\251 podlahov\303\251 vykurovanie.\' },\n      { q: \'Pracujete aj so sadrokart\303\263nom?\', a: \'Rob\303\255me kompletn\303\251 sadrokart\303\263nov\303\251 syst\303\251my vr\303\241tane sveteln\303\275ch r\303\241mp a podh\304\276adov.\' }\n    ]\n  }\n];\n\nconst renderTemplate = (opts) => {\n  const words = opts.title.split(\' \');\n  const styledTitle = words.map((w, i, a) => {\n    return i === a.length - 1 ? `<span className=\"text-[#E5A93B]\"> ${w}</span>` : w;\n  }).join(\' \');\n\n  return `import { FaqAccordion } from \'../components/FaqAccordion\';\nimport { HardHat, ChevronLeft, ChevronRight, Clock, ShieldCheck, Check, Phone, Sparkles, Facebook, Instagram, MapPin, Mail } from \'lucide-react\';\nimport TopNav from \'../components/TopNav\';\nimport Lightbox from \'../components/Lightbox\';\nimport { Link } from \'react-router-dom\';\nimport { useContactSheet } from \'../context/ContactSheetContext\';\nimport { motion } from \'motion/react\';\nimport { useState, useRef, useEffect } from \'react\';\n\nexport default function ${opts.componentName}() {\n  const galleryImages = [\n    \'https://images.unsplash.com/photo-1589939705384-5185137a7f0f?auto=format&fit=crop&q=80&w=800\',\n    \'https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&q=80&w=800\',\n    \'https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=800\',\n    \'https://images.unsplash.com/photo-1541888087625-f814d1f27dc0?auto=format&fit=crop&q=80&w=800\'\n  ];\n\n  const { openSheet } = useContactSheet();\n  const [lightboxIndex, setLightboxIndex] = useState<number | null>(null);\n  \n  const galleryRef = useRef<HTMLDivElement>(null);\n  const carouselRef = useRef<HTMLDivElement>(null);\n  const [activeGalleryIndex, setActiveGalleryIndex] = useState(0);\n  const [activeFeatureIndex, setActiveFeatureIndex] = useState(0);\n  \n  const scrollGallery = (direction: \'left\' | \'right\') => {\n    if (galleryRef.current) {\n      const scrollAmount = direction === \'left\' ? -300 : 300;\n      galleryRef.current.scrollBy({ left: scrollAmount, behavior: \'smooth\' });\n    }\n  };\n\n  const handleGalleryScroll = () => {\n    if (galleryRef.current) {\n      const scrollPosition = galleryRef.current.scrollLeft;\n      const itemWidth = 300 + 16;\n      const newIndex = Math.round(scrollPosition / itemWidth);\n      setActiveGalleryIndex(newIndex);\n    }\n  };\n\n  const scrollCarousel = (direction: \'left\' | \'right\') => {\n    if (carouselRef.current) {\n      const scrollAmount = direction === \'left\' ? -300 : 300;\n      carouselRef.current.scrollBy({ left: scrollAmount, behavior: \'smooth\' });\n    }\n  };\n\n  const handleCarouselScroll = () => {\n    if (carouselRef.current) {\n      const scrollPosition = carouselRef.current.scrollLeft;\n      const itemWidth = carouselRef.current.offsetWidth * 0.85 + 16;\n      const newIndex = Math.round(scrollPosition / itemWidth);\n      setActiveFeatureIndex(Math.min(newIndex, 2));\n    }\n  };\n\n  useEffect(() => {\n    window.scrollTo(0, 0);\n  }, []);\n\n  const icons = {\n    HardHat: <HardHat className=\"w-5 h-5 text-[#E5A93B]\" />,\n    ShieldCheck: <ShieldCheck className=\"w-5 h-5 text-[#E5A93B]\" />,\n    Check: <Check className=\"w-5 h-5 text-[#E5A93B]\" />,\n    Sparkles: <Sparkles className=\"w-5 h-5 text-[#E5A93B]\" />,\n    Clock: <Clock className=\"w-5 h-5 text-[#E5A93B]\" />\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#F5F5F5] font-sans antialiased selection:bg-[#E5A93B] selection:text-white pb-20 sm:pb-0\">\n      <div className=\"max-w-[480px] mx-auto bg-white min-h-screen relative shadow-2xl flex flex-col\">\n        <TopNav />\n        \n        {/* Hero Section */}\n        <section className=\"relative h-[65dvh] min-h-[450px] shrink-0 flex flex-col justify-end pb-12\">\n          <div className=\"absolute inset-0 z-0\">\n            <img \n              src=\"${opts.bgImg}\" \n              alt=\"${opts.title}\" \n              className=\"w-full h-full object-cover object-center\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/20\"></div>\n          </div>\n          \n          <div className=\"relative z-10 px-6 pt-20\">\n            <h1 \n              className=\"text-[42px] font-extrabold text-white leading-[1.05] tracking-tight mb-4 drop-shadow-sm\" \n              dangerouslySetInnerHTML={{ __html: \\`${styledTitle}\\` }} \n            />\n            <p className=\"text-[16px] text-gray-200 font-medium leading-[1.5] max-w-[280px] drop-shadow-sm\">\n              ${opts.subtitle}\n            </p>\n          </div>\n          \n          <div className=\"absolute -bottom-[2px] left-0 w-full z-20 pointer-events-none\">\n            <svg viewBox=\"0 0 1440 120\" className=\"w-full h-auto text-[#F5F5F5] fill-current preserve-3d\" preserveAspectRatio=\"none\">\n              <path d=\"M0,120 C320,120 420,0 720,0 C1020,0 1120,120 1440,120 L1440,120 L0,120 Z\"></path>\n            </svg>\n          </div>\n        </section>\n\n        {/* 1. SEO / Intro Paragraph */}\n        <section className=\"pt-12 pb-6 px-6 bg-[#F5F5F5]\">\n          <div className=\"relative flex flex-col items-center text-center\">\n            <div className=\"flex flex-col items-center mb-6 relative z-10\">\n              <span className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\n                ${opts.eyebrow}\n              </span>\n              <div className=\"w-8 h-[1px] bg-[#E5A93B]/30 mt-4\"></div>\n            </div>\n            \n            <div className=\"flex flex-col items-center text-center w-full max-w-[340px] relative z-10\">\n              <p className=\"text-[15px] text-gray-700 font-medium leading-[1.6] mb-8\">\n                ${opts.introText}\n              </p>\n              \n              <ul className=\"flex flex-col items-center gap-4 w-full\">\n                <li className=\"flex items-center justify-center gap-3 w-full\">\n                  <HardHat className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Sk\303\272sen\303\255 profesion\303\241li</span>\n                </li>\n                <li className=\"flex items-center justify-center gap-3 w-full\">\n                  <ShieldCheck className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Kvalitn\303\251 materi\303\241ly</span>\n                </li>\n                <li className=\"flex items-center justify-center gap-3 w-full\">\n                  <Check className=\"w-5 h-5 text-[#E5A93B]\" />\n                  <span className=\"text-[15px] text-[#1A1A1A] font-semibold\">Spokojnos\305\245 z\303\241kazn\303\255kov</span>\n                </li>\n              </ul>\n            </div>\n            \n            <div className=\"absolute -left-3 top-20 text-[#E8E6DB] opacity-60 pointer-events-none\">\n               <HardHat className=\"w-16 h-16 -rotate-12\" />\n            </div>\n          </div>\n        </section>\n\n        {/* 2. \304\214O JE S\303\232\304\214AS\305\244OU SLU\305\275BY */}\n        <section className=\"py-8 px-6 bg-[#F5F5F5]\">\n          <div className=\"bg-[#FAF9F5] rounded-[1.5rem] p-6 shadow-sm border border-black/5 flex flex-col gap-6\">\n            <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase text-center\">\n              \304\214O JE S\303\232\304\214AS\305\244OU SLU\305\275BY\n            </h2>\n            \n            <div className=\"flex flex-col gap-5\">\n              ${opts.included.map(item => `\n              <div className=\"flex items-center gap-4 border-b border-gray-200 pb-4 last:border-0 last:pb-0\">\n                <div className=\"w-6 h-6 rounded-full bg-[#E5A93B] flex items-center justify-center shrink-0\">\n                  <Check className=\"w-4 h-4 text-white\" strokeWidth={2} />\n                </div>\n                <span className=\"text-[13px] font-medium text-[#1A1A1A]\">${item}</span>\n              </div>`).join(\'\')}\n            </div>\n          </div>\n        </section>\n\n        {/* 3. UK\303\201\305\275KY NA\305\240EJ PR\303\201CE */}\n        <section className=\"py-8 bg-[#F5F5F5]\">\n          <div className=\"flex items-center justify-between w-full mb-6 px-6\">\n            <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\n              UK\303\201\305\275KY NA\305\240EJ PR\303\201CE\n            </h2>\n            <div className=\"flex gap-2\">\n              <button onClick={() => scrollGallery(\'left\')} className=\"w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center text-[#E5A93B] hover:bg-[#E5A93B]/5 transition-colors\">\n                <ChevronLeft className=\"w-4 h-4\" />\n              </button>\n              <button onClick={() => scrollGallery(\'right\')} className=\"w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center text-[#E5A93B] hover:bg-[#E5A93B]/5 transition-colors\">\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n          \n          <div \n            ref={galleryRef} \n            onScroll={handleGalleryScroll} \n            className=\"flex overflow-x-auto snap-x snap-mandatory gap-4 w-full pb-4 px-6 [&::-webkit-scrollbar]:hidden\" \n            style={{ scrollbarWidth: \'none\', msOverflowStyle: \'none\' }}\n          >\n            {galleryImages.map((src, idx) => (\n              <div key={idx} className=\"shrink-0\">\n                <img \n                  src={src} \n                  alt=\"Uk\303\241\305\276ka pr\303\241ce\" \n                  className=\"w-[300px] h-[225px] object-cover rounded-[1.5rem] shadow-[0_4px_20px_rgba(0,0,0,0.08)] snap-center cursor-pointer hover:opacity-90 transition-opacity\" \n                  onClick={() => setLightboxIndex(idx)} \n                />\n              </div>\n            ))}\n          </div>\n        </section>\n\n        {/* 4. PRE\304\214O T\303\201TO SLU\305\275BA? (Carousel) */}\n        <motion.section \n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true, margin: \"-50px\" }}\n          transition={{ duration: 0.5 }}\n          className=\"py-10 bg-[#F5F5F5] flex flex-col items-start overflow-hidden border-t border-[#E5A93B]/10\"\n        >\n          <div className=\"flex items-center justify-between w-full mb-6 px-6\">\n            <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase\">\n              PRE\304\214O T\303\201TO SLU\305\275BA?\n            </h2>\n            <div className=\"flex gap-2\">\n              <button onClick={() => scrollCarousel(\'left\')} disabled={activeFeatureIndex === 0} className={\\`w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center transition-colors \\${activeFeatureIndex === 0 ? \'opacity-30 cursor-not-allowed text-gray-400\' : \'text-[#E5A93B] hover:bg-[#E5A93B]/5\'}\\`}>\n                <ChevronLeft className=\"w-4 h-4\" />\n              </button>\n              <button onClick={() => scrollCarousel(\'right\')} disabled={activeFeatureIndex === 2} className={\\`w-8 h-8 rounded-full border border-[#E5A93B]/20 flex items-center justify-center transition-colors \\${activeFeatureIndex === 2 ? \'opacity-30 cursor-not-allowed text-gray-400\' : \'text-[#E5A93B] hover:bg-[#E5A93B]/5\'}\\`}>\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n          \n          <div \n            ref={carouselRef} \n            onScroll={handleCarouselScroll}\n            className=\"flex overflow-x-auto snap-x snap-mandatory gap-4 w-full pb-6 px-6 [&::-webkit-scrollbar]:hidden\" \n            style={{ scrollbarWidth: \'none\', msOverflowStyle: \'none\' }}\n          >\n            ${opts.carousel.map((feature, i) => `\n            <div className=\"min-w-[85%] sm:min-w-[280px] snap-center flex flex-col bg-white rounded-[1.5rem] p-7 shadow-[0_4px_20px_rgba(0,0,0,0.03)] border border-black/5 items-start text-left relative\">\n              <div className=\"w-12 h-12 rounded-full bg-[#F5F5F5] flex items-center justify-center mb-5\">\n                {icons[\'${feature.icon}\']}\n              </div>\n              <h3 className=\"text-[14px] font-extrabold text-[#1A1A1A] mb-3 uppercase tracking-wide\">${feature.title}</h3>\n              <p className=\"text-[14px] text-gray-600 font-medium leading-relaxed pr-6\">\n                ${feature.text}\n              </p>\n              <span className=\"absolute bottom-7 right-7 text-[11px] font-bold text-gray-300\">${i + 1} / 3</span>\n            </div>`).join(\'\')}\n          </div>\n        </motion.section>\n\n        {/* 5. \304\214AST\303\211 OT\303\201ZKY */}\n        <section className=\"py-8 px-6 bg-[#F5F5F5] border-t border-[#E5A93B]/10\">\n          <h2 className=\"text-[14px] font-extrabold tracking-widest text-[#E5A93B] uppercase mb-6 text-center\">\n            \304\214AST\303\211 OT\303\201ZKY\n          </h2>\n          <div className=\"flex flex-col gap-4\">\n            ${opts.faqs.map(faq => `\n            <FaqAccordion question=\"${faq.q}\" answer=\"${faq.a}\" />`).join(\'\')}\n          </div>\n        </section>\n\n        {/* 6. CTA Banner */}\n        <section className=\"px-6 pt-8 pb-12 bg-[#F5F5F5]\">\n          <div className=\"bg-white rounded-[1.5rem] p-6 flex flex-col items-center text-center shadow-md border border-[#E5A93B]/20\">\n            <div className=\"w-12 h-12 rounded-full bg-[#1A1A1A] flex items-center justify-center mb-4 shadow-md\">\n              <HardHat className=\"w-6 h-6 text-transparent fill-[#E5A93B]\" />\n            </div>\n            \n            <h3 className=\"text-[18px] font-extrabold text-[#1A1A1A] mb-2 leading-tight\">\n              M\303\241te projekt? <br /> Porozpr\303\241vajme sa o \305\210om.\n            </h3>\n            \n            <p className=\"text-[13px] text-gray-600 font-medium mb-6\">\n              Priprav\303\255me v\303\241m nez\303\241v\303\244zn\303\272 cenov\303\272 ponuku a navrhneme najlep\305\241ie rie\305\241enie pre va\305\241e b\303\275vanie.\n            </p>\n            \n            <button \n              onClick={openSheet}\n              className=\"w-full bg-[#E5A93B] hover:bg-[#111111] transition-colors text-white font-bold py-3.5 px-6 rounded-xl flex items-center justify-center gap-3 mb-4 shadow-md\"\n            >\n              <HardHat className=\"w-5 h-5 text-white\" strokeWidth={1.5} />\n              <span className=\"text-[13px] tracking-wider uppercase\">Z\303\215SKA\305\244 PONUKU</span>\n            </button>\n            \n            <a href=\"tel:+421907673697\" className=\"flex items-center gap-3 text-[#E5A93B] font-bold text-[15px] hover:text-[#1A1A1A] transition-colors\">\n              <Phone className=\"w-5 h-5\" strokeWidth={1.5} />\n              0907 673 697\n            </a>\n          </div>\n        </section>\n\n        {/* Footer */}\n        <footer className=\"bg-[#111111] pt-16 pb-8 px-6 text-white relative rounded-t-[2.5rem]\">\n          <div className=\"flex flex-col gap-8 mb-12\">\n            <div>\n              <h3 className=\"text-2xl font-extrabold flex items-center gap-3 mb-4\">\n                <HardHat className=\"w-6 h-6 text-[#E5A93B]\" strokeWidth={1.5} />\n                DESMO STAV, spol. s r.o.\n              </h3>\n              <p className=\"text-gray-400 text-[13px] font-medium leading-relaxed max-w-[250px]\">\n                Profesion\303\241lne stavebn\303\251 slu\305\276by a rekon\305\241trukcie pre va\305\241e lep\305\241ie b\303\275vanie.\n              </p>\n            </div>\n            \n            <div className=\"flex flex-col gap-4\">\n              <a href=\"tel:+421907673697\" className=\"flex items-center gap-3 text-[14px] font-medium text-white hover:text-[#E5A93B] transition-colors\">\n                <Phone className=\"w-5 h-5 text-[#E5A93B]\" strokeWidth={1.5} />\n                +421 907 673 697\n              </a>\n              <a href=\"mailto:info@desmostav.sk\" className=\"flex items-center gap-3 text-[14px] font-medium text-white hover:text-[#E5A93B] transition-colors\">\n                <Mail className=\"w-5 h-5 text-[#E5A93B]\" strokeWidth={1.5} />\n                info@desmostav.sk\n              </a>\n              <div className=\"flex items-start gap-3 text-[14px] font-medium text-white mt-2\">\n                <MapPin className=\"w-5 h-5 text-[#E5A93B] shrink-0\" strokeWidth={1.5} />\n                <span className=\"leading-relaxed\">P\303\264sob\303\255me v<br/>Bratislavskom a Trnavskom kraji</span>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-4 pt-4\">\n              <a href=\"#\" className=\"w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#E5A93B] transition-colors\">\n                <Facebook className=\"w-5 h-5 text-white\" strokeWidth={1.5} />\n              </a>\n              <a href=\"#\" className=\"w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#E5A93B] transition-colors\">\n                <Instagram className=\"w-5 h-5 text-white\" strokeWidth={1.5} />\n              </a>\n            </div>\n          </div>\n          \n          <div className=\"border-t border-white/10 pt-8 flex flex-col items-center text-center\">\n            <p className=\"text-[11px] text-gray-500 font-medium mb-4\">\n              \302\251 {new Date().getFullYear()} DESMO STAV, spol. s r.o. V\305\241etky pr\303\241va vyhraden\303\251.\n            </p>\n            <div className=\"flex gap-4\">\n              <a href=\"#\" className=\"text-[11px] text-gray-500 hover:text-white transition-colors\">Ochrana s\303\272kromia</a>\n              <a href=\"#\" className=\"text-[11px] text-gray-500 hover:text-white transition-colors\">Obchodn\303\251 podmienky</a>\n            </div>\n          </div>\n        </footer>\n      </div>\n      <Lightbox isOpen={lightboxIndex !== null} images={galleryImages} currentIndex={lightboxIndex ?? 0} onNavigate={setLightboxIndex} onClose={() => setLightboxIndex(null)} />\n    </div>\n  );\n}`;\n}\n\nfor (const s of services) {\n  fs.writeFileSync(s.file, renderTemplate(s));\n}\n\nconsole.log(\'Regenerated all service pages with ordered structure.\');\nEOF\nnode generate_services.cjs"
  }
}
